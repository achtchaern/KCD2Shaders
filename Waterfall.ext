////////////////////////////////////////////////////////////////////////////

Version (1.00)

Property
{
  Name = %SUN_SHADING
  Mask = 0x2
  Property    (Sun shading)
  Description (Activate for water sunshading - for outdoors)
}

Property
{
  Name = %FOAM
  Mask = 0x4
  Property    (Foam)
  Description (Enables foam rendering)
}

Property
{
  Name = %DEPTH_FOG
  Mask = 0x8
  Property    (Depth Fog)
  Description (Enables depth fog behind water surface)
}

Property
{
  Name = %VERTCOLORS
  Mask = 0x10
  DependencySet = $UserEnabled
  Hidden
}
