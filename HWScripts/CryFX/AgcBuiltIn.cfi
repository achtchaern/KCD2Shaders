    Texture1DArray<int4> source;
};

struct STexCpy1DU2FIndirect
{
    RWTexture1DArray<float4> target;
    Texture1DArray<uint4> source;
};

struct STexCpy1DRaw
{
	STexCpy1DRawIndirect* pIndirect;
    uint targetMip;
    uint sourceMip;
    uint targetSlice;
    uint sourceSlice;
    uint targetOffset;
    uint sourceOffset;
    uint region;
};

