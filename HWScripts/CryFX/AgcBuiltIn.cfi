// This file is also included on the C++ side to ensure no mismatching structures.
// These structures are intended to be passed under SV_UserData semantic (AGC extension).

struct SConstantColor
{
	float4 color;
};

struct SMemSet32
{
	RWStructuredBuffer<uint> target;
	uint source[4];
};

struct SMemSet128
{
	RWStructuredBuffer<uint4> target;
	uint4 source;
};

struct SMemCpy
{
	RWStructuredBuffer<uint4> target;
	StructuredBuffer<uint4> source;
};

struct STexCpy1DRawIndirect
{
    RWTexture1DArray<uint4> target;
    Texture1DArray<uint4> source;
};

struct STexCpy1DF2FIndirect
{
    RWTexture1DArray<float4> target;
    Texture1DArray<float4> source;
};

struct STexCpy1DF2SIndirect
{
    RWTexture1DArray<int4> target;
    Texture1DArray<float4> source;
};

struct STexCpy1DF2UIndirect
{
