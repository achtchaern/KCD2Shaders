<
  string Script =           
           "Public;"    
         #if !%THIN_HAIR
					 "ForceZpass;"
				 #else
				   "DepthFixup;"
         #endif
					 "AlphaBlendShadows;"
           "Hair;"
           "NoPreview;"           
