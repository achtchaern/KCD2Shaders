// Depth conversion
float GetLinearDepth(float fDevDepth, bool bScaled = false)
{
	return fDevDepth * (bScaled ? PS_NearFarClipDist.y : 1.0f);
}

float GetDeviceDepth(float fLinearDepth)
{
	return fLinearDepth;
}

#if FEATURE_RELAXED_PRECISION
min16float GetLinearDepth(min16float fDevDepth, bool bScaled = false)
{
	return fDevDepth * (bScaled ? PS_NearFarClipDist.y : 1.0f);
}

min16float GetDeviceDepth(min16float fLinearDepth)
{
	return fLinearDepth;
}
#endif

