struct AreaLightShadingAttribs
{
    float4x4 transform;
    float3 position;
    float3 lightPos;
    uint lightArrayIdx;
		// WH[TBa]: KCD2-73606
		float2 wallChamfer;
		float2 windowMargin;
		float wallThickness;
};

struct ForwardShadingAttribs
{
	min16float2  screenUV;
	float3  worldPos;
	min16float3  normal;
	min16float3  normalSpecProbe;
	min16float3  reflectance;
	min16float3  albedo;
	min16float   smoothness;
	
	CustomForwardShadingAttribs  custom;
    AreaLightShadingAttribs areaAttribs;
};

// WH[TBa]: keep synced with ETileLightFlagsWH, KCD2-444074
#define LIGHT_FLAG_SS_SHADOWS_FALLBACK_WH (0)
#define LIGHT_FLAG_SS_SHADOWS_FALLBACK_MASK_WH (1 << LIGHT_FLAG_SS_SHADOWS_FALLBACK_WH)

struct STiledLightShadeInfo
{
	uint      lightType;
	uint      resIndex;
	uint      shadowMaskIndex;
	uint      stencilID;
	float4    posRad;
	float4    attenuationParams;  // WH[TBa]: add fadeInRadius (z) and nearClip (w) params, KCD2-81869
	float2    shadowParams;
	float2    areaLightWallChamfer; // WH[TBa]: add for KCD2-73606
	float4    color;
	float4x4  projectorMatrix;
	float4x4  shadowMatrix;
	float2    areaLightWindowMargin; // WH[TBa]: add for KCD2-73606
	float     areaLightWallThickness; // WH[TBa]: add for KCD2-73606
	float     volumetricMultiplier; // WH[TBa]: correction for volumetric lighting (fog), KCD2-259576
	float     giMultiplier; // WH[TBa]: correction for GI/SVOTI, KCD2-328021
	float     shadowStrength; // WH[TBa]: we can use this to control the amount of shadow, KCD2-411675
	uint      spotShadowLightShadeMask; // WH[TomK]: Multiple spot shadows side mask (KCD2-359239)
	uint      flagsWH; // WH[TBa]: introduce additional flags, starting with LIGHT_FLAG_SS_SHADOWS_FALLBACK_WH for KCD2-444074
};

//WH[TBa]: factor clipping and attenuation out of illuminance, so we can simulate more complex light types inside shading callbacks, KCD2-291146, KCD2-74373
struct IlluminanceEvaluationContextWH
{
	float3 color; // light color times texture, times shadow, common/same for all light types
	float clipping; // limit by radius and fadeIn times clip volume fade in, common/same for all light types
	float inverseSquareAttenuation; // depends on the light type, only approximate for area lights (for shaders that cannot use the ltc-ggx model)
};

struct ForwardLightParams
{
	min12int     type;
	min16float3  lightVec;

	//WH[TBa]: factor clipping and attenuation out of illuminance, so we can simulate more complex light types inside shading callbacks, KCD2-291146, KCD2-74373
	IlluminanceEvaluationContextWH illuminanceWH;
};

// WH[TBa]: constructor for ForwardLightParams, default-initialize all properties
ForwardLightParams CreateForwardLightParamsWH(min12int type)
{
	ForwardLightParams ret;
	ret.type = type;
	ret.lightVec = 0;
	ret.illuminanceWH.color = 0;
	ret.illuminanceWH.clipping = 1;
	ret.illuminanceWH.inverseSquareAttenuation = 1;
	return ret;
}

#define TILED_SHADING_SPECPROBE_MAXMIP  6

////////////////////////////////////////////////////////////////////////////////////////////////////

float GetDissolveThreshold5(int2 sc)
{
	// 4 transparency levels for a 2x2 quad. We're using dot/abs instead, since rsx doens't support array indexing.
	return abs(dot(min16float4(0.0h, 0.76h, 0.5h,-1.0h), sc.xxyy % 2));
}

float GetDissolveThreshold9(int2 sc)
{
	float tm[2][4] =
	{
		{  0.0f / 8,  4.0f / 8,  2.0f / 8,  6.0f / 8 },
		{  3.0f / 8,  7.0f / 8,  1.0f / 8,  5.0f / 8 }
	};

	return tm[sc.y & 1][sc.x & 3];
}

float GetDissolveThreshold17(int2 sc)
{
	float tm[4][4] =
	{
		{  0.0f / 16,  12.0f / 16,   3.0f / 16,  15.0f / 16 },
		{  8.0f / 16,   4.0f / 16,  11.0f / 16,   7.0f / 16 },
		{  2.0f / 16,  14.0f / 16,   1.0f / 16,  13.0f / 16 },
		{ 10.0f / 16,   6.0f / 16,   9.0f / 16,   5.0f / 16 }
	};

	return tm[sc.y & 3][sc.x & 3];
}

float GetDissolveThreshold33(int2 sc)
{
	float tm[4][8] =
	{
		{  0.0f / 32,  16.0f / 32,   8.0f / 32,  24.0f / 32,   2.0f / 32,  18.0f / 32,  10.0f / 32,  26.0f / 32 },
		{ 12.0f / 32,  28.0f / 32,   4.0f / 32,  20.0f / 32,  14.0f / 32,  30.0f / 32,   6.0f / 32,  22.0f / 32 },
		{  3.0f / 32,  19.0f / 32,  11.0f / 32,  27.0f / 32,   1.0f / 32,  17.0f / 32,   9.0f / 32,  25.0f / 32 },
		{ 15.0f / 32,  31.0f / 32,   7.0f / 32,  23.0f / 32,  13.0f / 32,  29.0f / 32,   5.0f / 32,  21.0f / 32 }
	};

	return tm[sc.y & 3][sc.x & 7];
}

float TestDissolve(float fDissolve, int2 sc, int levels = 17)
{
#if %_RT_DISSOLVE
	float fThreshold = 0;
	if (levels <= 5)
		fThreshold = GetDissolveThreshold5(sc);
	else if (levels <= 9)
		fThreshold = GetDissolveThreshold9(sc);
	else if (levels <= 17)
		fThreshold = GetDissolveThreshold17(sc);
	else if (levels <= 33)
		fThreshold = GetDissolveThreshold33(sc);
	else
		fThreshold = 0;

	return (fDissolve >= 0 ? 1 : -1) * (fThreshold - abs(fDissolve));
#else
	return 0.0f;
#endif
}

void ApplyDissolve(float fDissolve, int2 sc, int levels = 17)
{
#if %_RT_DISSOLVE
	clip(TestDissolve(fDissolve, sc, levels));
#endif
}

//////////////////////////////// Common shading utilities ////////////////

// assumes 0 is min
min16float smoothstep_opt(in min16float maxi, in min16float x)
{
  x = saturate( x / maxi );
  return  x * x  * (3.0 - 2.0 * x);
}

min16float GlossToSpecExp255(in min16float gloss)
{
	return gloss * 255.h;
}

min16float GetFresnel(min16float NdotI, min16float bias, min16float power)
{
  min16float facing = (1.0 - NdotI);
  return saturate(bias + (1-bias)*pow(facing, power));
}

min16float3 GetEnvmapFresnel(min16float3 specCol0, min16float gloss, min16float fNdotE)
{
	const min16float3 specCol90 = min16float3( 1, 1, 1 );

	// Empirical approximation to the reduced gain at grazing angles for rough materials
	return lerp( specCol0, specCol90, pow( 1 - saturate( fNdotE ), 5 ) / (40 - 39 * gloss) );
}

min16float GetAttenuation(min16float3 L, min16float fInvRadius, bool bUserFalloff = false, min16float fFalloffMax = 1.0h)
{
  min16float3 vDist = L * fInvRadius;
  min16float fFallOff = saturate(1 + dot(vDist, -vDist));

	if( bUserFalloff )
		fFallOff = smoothstep_opt( fFalloffMax, fFallOff);

  return fFallOff;
}

// WH[TBa]: factor clipping out of physical light attenuation as area light sources have their own attenuation model, KCD2-291146, KCD2-74373
min16float GetLightClippingWH(STiledLightShadeInfo light, min16float fDist)
{
	const min16float radius = light.posRad.w;
	const min16float fNearClip = light.attenuationParams.w;
	const min16float fFadeInRadiusAndClip = light.attenuationParams.z + fNearClip;
	min16float d = fDist;

	// Fadeout last 30% of radius
	// WH[LH] nicer curve with no 2nd order discontinuity
	min16float fadeoutFactor = 1.0f - smoothstep(0.7*radius, radius, d);

	// WH[TBa]: add near clip and fade in radius, KCD2-81869
	min16float fadeInFactor = step(fNearClip, d);

	// WH[Woody,TBa]: fade-in
	if (fFadeInRadiusAndClip > 0.f)
	{
		min16float fadeInCoef = saturate(d / fFadeInRadiusAndClip);
		fadeInFactor *= fadeInCoef * fadeInCoef; // WH[Woody]: quadratic version looks better
	}

	return fadeInFactor * fadeoutFactor;
}

// WH[TBa]: physical light source modelled as a sphere (light bulb), KCD2-291146, KCD2-74373
min16float GetPhysicalBulbLightAttenuationWH(STiledLightShadeInfo light, min16float fDist)
{
	const min16float fAttenuationBulbSize = light.attenuationParams.x;
	min16float d = fDist;

	// Light attenuation model: 1 / (1 + d/lightsize)^2
	d = max(d - fAttenuationBulbSize, 0);
	min16float denom = 1 + d / fAttenuationBulbSize;
	min16float fAttenuation = 1 / (denom * denom);

	return fAttenuation;
}

min16float GetSpotAttenuation(min16float fPdotL, min16float fCosAngle, min16float fRadius)
{
	// Compute cosine of spot direction and light.
	min16float fSpotFalloff = fCosAngle / (fPdotL+1e-6); // 1 alu
	
	// Apply planar falloff and computed spot falloff.
	min16float fFallOff = 1.0h - pow(saturate(fSpotFalloff), fRadius); //  4 alu

	return fFallOff;
}

float3 MapCubeToSphere(float3 pos)
{
	float3 pos2 = pos.xyz * pos.xyz;
	return pos * sqrt(1 - rcp(2) * (pos2.yzx + pos2.zxy) + rcp(3) * (pos2.yzx * pos2.zxy));
}

min16float3 ShiftVector(min16float3 V, min16float3 N, min16float shiftAmount)
{
  return normalize(V + shiftAmount * N);
  // 3 alu, 1 mad
}

// optimized shift vector - skips normalization - use only when vector lenght not relevant
min16float3 ShiftVectorOpt(min16float3 V, min16float3 N, min16float shiftAmount)
{
  return (V + shiftAmount * N);
  // 1 mad
}

//////////////////////////////// Common HDR encoding/decoding ////////////////////////////////

#define MAX_FLOAT						128.h

#define fHDR_EXP_BASE_1_04	1.04h
#define fHDR_EXP_BASE_1_06	1.06h
#define fHDR_EXP_OFFSET			128.h

// Using RGBK format (multiplier in alpha - filtering should work fine)
// quality: good	
min16float4 EncodeRGBK(in min16float4 Color, const min16float fMultiplier, bool bUsePPP = false)
{
	const min16float4 cScale = min16float4(min16float3(1.h, 1.h, 1.h) / fMultiplier, 1.h / 255.0);
	min16float fMax = saturate(dot(min16float4(Color.rgb, 1.h), cScale));   // 1 alu

	Color.a = ceil(fMax * 255.h) / 255.h;                       // 3 alu

	Color.xyz /= Color.a * fMultiplier;                         // 2alu

  if( bUsePPP )
  {
	//Color *= rsqrt( Color ); // for best quality

	Color.a = sqrt( Color.a ); // encode just multiplier for performance reasons
  }

  return Color;
}

void EncodeRGBKPair(inout min16float4 Color0, inout min16float4 Color1, const min16float fMultiplier, bool bUsePPP = false)
{
  min16float fMax0 = saturate(dot(Color0.rgb, 1.h / fMultiplier));    // 1 alu
  min16float fMax1 = saturate(dot(Color1.rgb, 1.h / fMultiplier));    // 1 alu

  Color0.a = ceil(fMax0 * 255.h) / 255.h;                       // 3 alu
  Color1.a = ceil(fMax1 * 255.h) / 255.h;                       // 3 alu

  Color0.xyz /= Color0.a * fMultiplier;                         // 2alu
  Color1.xyz /= Color1.a * fMultiplier;                         // 2alu
  
  if( bUsePPP )
  {
	  //Color0 *= rsqrt( Color0 ); // for best quality
	  //Color0 *= rsqrt( Color0 ); 

		Color0.a = sqrt( Color0.a ); // encode just multiplier for performance reasons
		Color1.a = sqrt( Color1.a );

  }
}

min16float4 DecodeRGBK(in min16float4 Color, const min16float fMultiplier, bool bUsePPP= false)
{
  if( bUsePPP )
  {
	 //Color.rgb *= Color.rgb * (Color.a * Color.a) * fMultiplier;

	Color.rgb *= (Color.a * Color.a) * fMultiplier;
  }
  else
    Color.rgb *= Color.a * fMultiplier;

  return Color;
}

