#include "Common.cfi"
#include "PostEffectsLib.cfi"
#include "ShadeLib.cfi"
#include "imageLib.cfi"
#include "CommonColorTransforms.cfi"

// Shader global descriptions
float Script : STANDARDSGLOBAL
<
  string Script =
           "NoPreview;"
           "LocalConstants;"
           "ShaderDrawType = Custom;"
           "ShaderType = PostProcess;"
>; 

/// PostAA techniques /////////////////////////////////////////////////////////////////////////

/// Input/output color processing ///

// These are used both by SMAA and the temporal pass

float3 PostAAProcessColorInput(float3 color, float exposure)
{
#if %_RT_SAMPLE4 // Input is HDR

	// HDR needs to be exposed first
	color *= exposure;

	// Perform AA in reversable tonemapping space to avoid bright HDR values dominating.
	// See: "High Quality Temporal Supersampling", Karis 2014, pages 17-22
	// See: "A Quick Overview of MSAA", Pettineo 2012, blogpost: https://mynameismjp.wordpress.com/2012/10/24/msaa-overview/
	return LinearTonemap(color);

#else
	return color;
#endif
}

float3 PostAAProcessColorOutput(float3 color, float exposure)
{

#if %_RT_SAMPLE4 // Output is HDR, processing was done in tonemapped space

	color = InverseLinearTonemap(color);

	 // Input was exposed, need to revert
	color *= rcp(exposure);

#endif

	return color;
}

/// Specific data ////////////////////////

float4x4 mViewProjPrev;
float4x4 mReprojection;
float4 vParams;
float4 HDREyeAdaptation;

// parameters for batched techniques into same pass
float4 vLensOpticsParams;
float4 vDebugParams;

////////////////// samplers /////////////////////

struct vtxOutAA
{
  OUT_HPOS_IN_WPOS

  float4 baseTC      : TEXCOORD0;
  float4 CamVec      : TEXCOORD1;
};

vtxOutAA PostAA_VS(vtxInWPOS IN)
{
  vtxOutAA OUT = (vtxOutAA)0; 

  float4 vPos = IN.Position;
  vPos.y = 1 -vPos.y;
	OUT.HPosition = float4(vPos.xy*2-1, vPos.z, 1.0);

  OUT.baseTC.xy = IN.baseTC.xy;
	OUT.baseTC.zw = 1.0 / g_VS_HPosScale.xy;
  OUT.CamVec.xyz = IN.CamVec;

  return OUT;
}

///////////////// pixel shader //////////////////

float ClipHistory(min16float3 cHistory, min16float3 cM, min16float3 cMin, min16float3 cMax)
{
	// Clip color difference against neighborhood min/max AABB
	// Clipped color is cHistory + rayDir * result
	
	float3 boxCenter = (cMax + cMin) * 0.5;
	float3 boxExtents = cMax - boxCenter;
	
	float3 rayDir = cM - cHistory;
	float3 rayOrg = cHistory - boxCenter;
	
	return saturate(IntersectAABB(rayDir, rayOrg, boxExtents));
}

float3 FilterHistory(Texture2D<float4> tex, SamplerState sampSt, float2 texcoord, float4 texSize)
{
	const float Sharpening = 0.0;  // [-0.5, 0.5]

	float2 samplePos = texcoord * texSize.xy;
	float2 tc1 = floor(samplePos - 0.5) + 0.5;
	float2 f = samplePos - tc1;
	float2 f2 = f * f;
	float2 f3 = f * f2;

	// Catmull-Rom weights
	const float c = 0.5 + Sharpening;
	float2 w0 = -(c)       * f3 + (2.0 * c)        * f2 - (c * f);
	float2 w1 =  (2.0 - c) * f3 - (3.0 - c)        * f2            + 1.0;
	float2 w2 = -(2.0 - c) * f3 + (3.0 -  2.0 * c) * f2 + (c * f);
	float2 w3 =  (c)       * f3 - (c)              * f2;

	float2 w12  = w1 + w2;
	float2 tc0  = (tc1 - 1.0)      * texSize.zw;
	float2 tc3  = (tc1 + 2.0)      * texSize.zw;
	float2 tc12 = (tc1 + w2 / w12) * texSize.zw;
	
	// Bicubic filter using bilinear lookups, skipping the 4 corner texels
	float4 filtered = float4(GetTexture2D(tex, sampSt, float2(tc12.x, tc0.y )).rgb, 1.0) * (w12.x *  w0.y) +
	                  float4(GetTexture2D(tex, sampSt, float2(tc0.x,  tc12.y)).rgb, 1.0) * ( w0.x * w12.y) +
	                  float4(GetTexture2D(tex, sampSt, float2(tc12.x, tc12.y)).rgb, 1.0) * (w12.x * w12.y) +  // Center pixel
	                  float4(GetTexture2D(tex, sampSt, float2(tc3.x,  tc12.y)).rgb, 1.0) * ( w3.x * w12.y) +
	                  float4(GetTexture2D(tex, sampSt, float2(tc12.x, tc3.y )).rgb, 1.0) * (w12.x *  w3.y);
	
	return filtered.rgb * rcp(filtered.a);
}


Texture2D<float4> PostAA_LDRNatTarg       : register(t0);
Texture2D<float4> PostAA_PrvNatTarg       : register(t1);
SamplerState PostAA_CPSS                  : register(s0);   //LinearClamp
SamplerState PostAA_LVSS                  : register(s1);   //PointClamp 

Texture2D<float4> PostAA_LinDpth          : register(t2);
Texture2D<float4> PostAA_VelObj           : register(t3);

Texture2D<float4> PostAA_DepthTex         : register(t16);

Texture2D<float2> PostAA_SceneLuminance   : register(t4);

float4x4 currMatReprojection;
float4x4 prevMatReprojection;
float4 postAAParams;
float4 postAAScreenSize;

#define SMAA_2TX_SINGLE_TAP_BICUBIC_HISTORY 1
#define SMAA_2TX_FLICKER_SUPRESSION 1

pixout PostAA_PS(vtxOutAA IN)
{
	pixout OUT = (pixout) 0;
	
#if %_RT_MULTIVIEW && FEATURE_VR_MULTIVIEW
	const uint viewId = ViewID;
#else
	const uint viewId = 0;
#endif

	const float sceneIlluminance = PostAA_SceneLuminance.Load(int3(0, 0, 0)).y;
	const float exposure = ComputeExposure(sceneIlluminance, HDREyeAdaptation);

	const float2 tc = IN.baseTC.xy;
	const float2 texel = postAAScreenSize.zw;
	
	// Compute velocity vector for static geometry
	// WH[TBa]: implicit truncation of vector type, KCD2-448804
	float depth = PostAA_DepthTex.Load(int3(IN.WPos.xy, 0)).x;
	int2 velocityOffset = 0;

	#if %_RT_SAMPLE3 || !%_RT_SAMPLE2
	// Dilate depth and velocity to improve moving silhouette edges.
	// See: "High Quality Temporal Supersampling", Karis 2014, page 27
	// See: "Temporal Reprojection Anti Aliasing in INSIDE", Pedersen 2016, page 20
	{
		const int2 offset1 = int2(-1, -1);
		const int2 offset2 = int2( 1, -1);
		const int2 offset3 = int2(-1,  1);
		const int2 offset4 = int2( 1,  1);

		// Pick closest depth from 5-neighborhood.
		float depth1 = PostAA_DepthTex.Load(int3(IN.WPos.xy, 0), offset1).r;
		float depth2 = PostAA_DepthTex.Load(int3(IN.WPos.xy, 0), offset2).r;
		float depth3 = PostAA_DepthTex.Load(int3(IN.WPos.xy, 0), offset3).r;
		float depth4 = PostAA_DepthTex.Load(int3(IN.WPos.xy, 0), offset4).r;

		depth = max(max(max(max(depth1, depth2), depth3), depth4), depth);

		// Matching velocity offset
		velocityOffset = depth == depth1 ? offset1 : velocityOffset;
		velocityOffset = depth == depth2 ? offset2 : velocityOffset;
		velocityOffset = depth == depth3 ? offset3 : velocityOffset;
		velocityOffset = depth == depth4 ? offset4 : velocityOffset;
	}
	#endif
	
	const float linearDepth = g_PS_ProjRatio.y / (depth - g_PS_ProjRatio.x);

	const float3 vPosWS = WorldViewPos.xyz + IN.CamVec.xyz * linearDepth;
	const float2 vCam = GetCameraVelocity(vPosWS, currMatReprojection, prevMatReprojection);
	const float2 vObj = PostAA_VelObj.Load(int3(IN.WPos.xy + velocityOffset, 0)).rg;

	// WH[DH]: Removed motion blur fast path, it does not work well with dynamic objects that do not support motion vectors
	const float2 v = CombineObjectAndCameraVelocity(vObj, vCam);
	const bool offscreen = max(abs((tc.x + v.x) * 2 - 1), abs((tc.y + v.y) * 2 - 1)) >= 1.0;

	// Curr frame and neighbor texels
	// WH[TBa]: implicit truncation of vector type, KCD2-448804
	half3 cM  = PostAA_LDRNatTarg.Load(int3(IN.WPos.xy, 0)).rgb;

	// Default result: current color + no history weight
	OUT.Color.rgb = cM;
	
	// Prev frame texel (fall back to current pixel if offsceen)
	[branch] if (!offscreen)
	{
		const float2 tcHistory = tc + v;
		half4 cHistory = GetTexture2D(PostAA_PrvNatTarg, PostAA_CPSS, tcHistory);

		cM           = PostAAProcessColorInput(cM,           exposure);
		cHistory.rgb = PostAAProcessColorInput(cHistory.rgb, exposure);

		// Both TSAA and SMAA 1TX use diagonal neighbors.
		// SMAA 2TX may use direct neighbors depending on config.
#if %_RT_SAMPLE3 || %_RT_SAMPLE2
		float3 cTL = PostAA_LDRNatTarg.Load(int3(IN.WPos.xy, 0), int2(-1, -1)).rgb;
		float3 cTR = PostAA_LDRNatTarg.Load(int3(IN.WPos.xy, 0), int2( 1, -1)).rgb;
		float3 cBL = PostAA_LDRNatTarg.Load(int3(IN.WPos.xy, 0), int2(-1,  1)).rgb;
		float3 cBR = PostAA_LDRNatTarg.Load(int3(IN.WPos.xy, 0), int2( 1,  1)).rgb;

		cTL = PostAAProcessColorInput(cTL, exposure);
		cTR = PostAAProcessColorInput(cTR, exposure);
		cBL = PostAAProcessColorInput(cBL, exposure);
		cBR = PostAAProcessColorInput(cBR, exposure);
#endif

#if %_RT_SAMPLE3
		// TSAA
		const float fMaxWeightL = 0.25;
		const float fMaxWeightH = 0.08;
	
	// WH[MMatous]: implicit truncation of vector type, KCD2-448804
		min16float3 cLL = PostAA_LDRNatTarg.Load(int3(IN.WPos.xy, 0), int2(-1,  0)).rgb;
		min16float3 cRR = PostAA_LDRNatTarg.Load(int3(IN.WPos.xy, 0), int2( 1,  0)).rgb;
		min16float3 cTT = PostAA_LDRNatTarg.Load(int3(IN.WPos.xy, 0), int2( 0, -1)).rgb;
		min16float3 cBB = PostAA_LDRNatTarg.Load(int3(IN.WPos.xy, 0), int2( 0,  1)).rgb;
		//WH ocg.polischuk fix for TAA in HDR color
		cLL = PostAAProcessColorInput(cLL, exposure);
		cRR = PostAAProcessColorInput(cRR, exposure);
		cTT = PostAAProcessColorInput(cTT, exposure);
		cBB = PostAAProcessColorInput(cBB, exposure);
		// Keep the .w, replace the color
		cHistory.rgb = FilterHistory(PostAA_PrvNatTarg, PostAA_CPSS, tc + v, postAAScreenSize);
		//WH ocg.polischuk fix for TAA in HDR color
		cHistory.rgb = PostAAProcessColorInput(cHistory.rgb, exposure);
		// Compute color variance
		const min16float3 m1 = cTL + cTR + cBL + cBR + cLL + cRR + cTT + cBB + cM;
		const min16float3 m2 = cTL*cTL + cTR*cTR + cBL*cBL + cBR*cBR + cLL*cLL + cRR*cRR + cTT*cTT + cBB*cBB + cM*cM;
		const min16float3 mean = m1 / 9;
		// WH GM: added max to prevent NaN caused by float imprecision 
		const min16float3 stddev = sqrt(max(m2 / 9 - mean * mean, 0));
		const min16float3 cMin = mean - 1.0 * stddev;
		const min16float3 cMax = mean + 1.0 * stddev;
	
		float clipLength = ClipHistory(cHistory.rgb, cM, cMin, cMax);
	
		// Try to identify subpixel changes
		min16float4 prevTL = GetTexture2DLod(PostAA_PrvNatTarg, PostAA_CPSS, float4(tc + v + texel * float2(-1.0f, -1.0f), 0, 0));
		min16float4 prevTR = GetTexture2DLod(PostAA_PrvNatTarg, PostAA_CPSS, float4(tc + v + texel * float2( 1.0f, -1.0f), 0, 0));
		min16float4 prevBL = GetTexture2DLod(PostAA_PrvNatTarg, PostAA_CPSS, float4(tc + v + texel * float2(-1.0f,  1.0f), 0, 0));
		min16float4 prevBR = GetTexture2DLod(PostAA_PrvNatTarg, PostAA_CPSS, float4(tc + v + texel * float2( 1.0f,  1.0f), 0, 0));
		//WH ocg.polischuk fix for TAA in HDR color
		prevTL.rgb = PostAAProcessColorInput(prevTL.rgb, exposure);
		prevTR.rgb = PostAAProcessColorInput(prevTR.rgb, exposure);
		prevBL.rgb = PostAAProcessColorInput(prevBL.rgb, exposure);
		prevBR.rgb = PostAAProcessColorInput(prevBR.rgb, exposure);
		min16float4 prevTT = GetTexture2DLod(PostAA_PrvNatTarg, PostAA_CPSS, float4(tc + v + texel * float2( 0.0f, -1.0f), 0, 0));
		min16float4 prevBB = GetTexture2DLod(PostAA_PrvNatTarg, PostAA_CPSS, float4(tc + v + texel * float2( 0.0f,  1.0f), 0, 0));
		min16float4 prevLL = GetTexture2DLod(PostAA_PrvNatTarg, PostAA_CPSS, float4(tc + v + texel * float2(-1.0f,  0.0f), 0, 0));
		min16float4 prevRR = GetTexture2DLod(PostAA_PrvNatTarg, PostAA_CPSS, float4(tc + v + texel * float2( 1.0f,  0.0f), 0, 0));
		//WH ocg.polischuk fix for TAA in HDR color
		prevTT.rgb = PostAAProcessColorInput(prevTT.rgb, exposure);
		prevBB.rgb = PostAAProcessColorInput(prevBB.rgb, exposure);
		prevLL.rgb = PostAAProcessColorInput(prevLL.rgb, exposure);
		prevRR.rgb = PostAAProcessColorInput(prevRR.rgb, exposure);
		float neighborDiff1 =
			length(clamp(prevTL.rgb, cMin, cMax) - prevTL.rgb) + length(clamp(prevTR.rgb, cMin, cMax) - prevTR.rgb) +
			length(clamp(prevBL.rgb, cMin, cMax) - prevBL.rgb) + length(clamp(prevBR.rgb, cMin, cMax) - prevBR.rgb);
		float neighborDiff2 =
			length(clamp(prevTT.rgb, cMin, cMax) - prevTT.rgb) + length(clamp(prevBB.rgb, cMin, cMax) - prevBB.rgb) +
			length(clamp(prevLL.rgb, cMin, cMax) - prevLL.rgb) + length(clamp(prevRR.rgb, cMin, cMax) - prevRR.rgb);
		
		float neighborDiff = min(neighborDiff1, neighborDiff2);
		if (neighborDiff < postAAParams.x)
			clipLength = 0;
	
		// Apply color clipping
		cHistory.rgb = lerp(cHistory.rgb, cM, clipLength);
	
		min16float prevBlend = (cHistory.w + prevTL.w + prevTR.w + prevBL.w + prevBR.w + prevTT.w + prevBB.w + prevLL.w + prevRR.w) / 9.0;
		cHistory.w = saturate(neighborDiff * 10) * 0.10 + prevBlend * 0.90;

		// How much of History do we want? 0.25 to 0.08, Low frequency means take more from the History.
		float weight = lerp(fMaxWeightL, fMaxWeightH, saturate(cHistory.w * postAAParams.y));
	
		OUT.Color.rgb = lerp(cHistory.rgb, cM, weight);
		//WH ocg.polischuk fix for TAA in HDR color
		OUT.Color.rgb = PostAAProcessColorOutput(OUT.Color.rgb, exposure);
		OUT.Color.a = cHistory.w;

#elif %_RT_SAMPLE2
		// SMAA 1TX Mode
		const float fMaxFramesL = postAAParams.z;		// Frames to keep in history (low freq). Higher = less aliasing, but blurier result. Lower = sharper result, but more aliasing.
		const float fMaxFramesH = postAAParams.w;		// Frames to keep in history (high freq). Higher = less aliasing, but blurier result. Lower = sharper result, but more aliasing.
	
		const min16float3 cMin = min(min(min(min(cTL, cTR), cBL), cBR), cM);
		const min16float3 cMax = max(max(max(max(cTL, cTR), cBL), cBR), cM);	

		cHistory.rgb = clamp(cHistory.rgb, cMin, cMax); // Limit acc buffer color range to current frame

		// How much of History do we want? Low frequency means take more from the History.
		const float3 cBlur = (cTL + cTR + cBL + cBR) * 0.25f;
		min16float3 cHiFreq = sqrt(abs(cBlur.rgb - cM.rgb));
		// WH[TBa]: implicit truncation of vector type, KCD2-448804
		float weight = saturate(rcp(lerp(fMaxFramesL, fMaxFramesH, GetLuminance(cHiFreq))));

		OUT.Color.rgb = PostAAProcessColorOutput(lerp(cHistory.rgb, cM, weight), exposure);
		OUT.Color.a = 1 - weight; // debug output

#else
		// New SMAA 2TX Mode
        const float fMaxFramesL = postAAParams.z; // Frames to keep in history (low freq). Higher = less aliasing, but blurier result. Lower = sharper result, but more aliasing.
        const float fMaxFramesH = postAAParams.w; // Frames to keep in history (high freq). Higher = less aliasing, but blurier result. Lower = sharper result, but more aliasing.
		float3 cMin;
		float3 cMax;
		float localContrast;

#if SMAA_2TX_SINGLE_TAP_BICUBIC_HISTORY
		// One tap bicubic history filtering approximation using current frame neighborhood.
		// See "Dynamic Temporal Antialiasing and Upsampling in Call of Duty", Jimenez 2017, pages 103-137.
		// Counteracts blurring in motion.
		{
			// Need direct neighbors for bicubic approximation.
			// Since we need them here we use for the neighborhood min/max instead of diagonals.
			// We could use diagonals in addition for min/max for full 3x3 neighborhood.
			// Better in theory but not noticeable in practice.

			//WH ocg.polischuk .rgb to fix truncation warning
			float3 cL = PostAA_LDRNatTarg.Load(int3(IN.WPos.xy, 0), int2(-1,  0)).rgb;
			float3 cR = PostAA_LDRNatTarg.Load(int3(IN.WPos.xy, 0), int2( 1,  0)).rgb;
			float3 cT = PostAA_LDRNatTarg.Load(int3(IN.WPos.xy, 0), int2( 0,  1)).rgb;
			float3 cB = PostAA_LDRNatTarg.Load(int3(IN.WPos.xy, 0), int2( 0, -1)).rgb;

			cL = PostAAProcessColorInput(cL, exposure);
			cR = PostAAProcessColorInput(cR, exposure);
			cT = PostAAProcessColorInput(cT, exposure);
			cB = PostAAProcessColorInput(cB, exposure);

			cMin = min(min(min(min(cL, cR), cT), cB), cM);
			cMax = max(max(max(max(cL, cR), cT), cB), cM);

			//WH ocg.polischuk added GetLuminance call
			localContrast = GetLuminance(abs(0.25 * (cL + cR + cB + cT) - cM));

			const float2 historyCoordinate = tcHistory * postAAScreenSize.xy - 0.5;
			const float2 historyFraction = frac(historyCoordinate);

			// Compute sharpness.
			// Retain texture detail which is typically low contrast.
			// Avoid sharpening edges which might reintroduce aliasing which is typically high contast.
			// Compare history to current color luminance and start decreasing sharpness when the difference is high.
			//WH ocg.polischuk .rgb to fix truncation warning
			const float luminanceHistory = GetLuminance(cHistory.rgb);
			const float luminanceCurrent = GetLuminance(cM);
			const float luminanceDelta = abs(luminanceHistory - luminanceCurrent);

			const float sharpnessFalloffStart = 0.1;
			const float sharpnessFalloffEnd   = 0.3;
			const float sharpnessMax = 0.8;
			float sharpness = sharpnessMax * (1 - saturate((luminanceDelta - sharpnessFalloffStart) / (sharpnessFalloffEnd - sharpnessFalloffStart)));

			// Reduce sharpness when the neighborhood is too different from history.
			// This avoids dark ringing artifacts around small, bright spots, e.g. specular highlights
			const float deltaFalloffStart = 0.05;
			const float deltaFalloffEnd   = 0.1;
			const float neighborhoodHistoryDelta = max(abs(luminanceHistory - GetLuminance(cMax)), abs(luminanceHistory - GetLuminance(cMin)));
			sharpness *= (saturate(1 - (neighborhoodHistoryDelta - deltaFalloffStart) / (deltaFalloffEnd - deltaFalloffStart)));

			// See presentation mentioned above for details.
			// The core idea is to use the current neighborhood to approximate bicubic filtering without the additional cost.
			// The calculations are simplified down to a lerp between neighbors and a weighted sum.
			// Intuitively this boils down to a directional sharpening filter that increases in strength when sampling between pixels.
			const float2 weight = sharpness * 0.8 * (historyFraction * historyFraction - historyFraction);

			const float4 horizontal = float4(lerp(cL, cR, historyFraction.x), 1) * weight.x;
			const float4 vertical   = float4(lerp(cB, cT, historyFraction.y), 1) * weight.y;

			float4 sum = horizontal + vertical;
			sum += float4(cHistory.rgb * (1 + sum.a) - sum.a * cM, 1);

			cHistory.rgb = saturate(sum.rgb * rcp(sum.a));
		}
#else // SMAA_2TX_SINGLE_TAP_BICUBIC_HISTORY
		{
			//WH ocg.polischuk .rgb to fix truncation warning
			float3 cTL = PostAA_LDRNatTarg.Load(int3(IN.WPos.xy, 0), int2(-1, -1)).rgb;
			float3 cTR = PostAA_LDRNatTarg.Load(int3(IN.WPos.xy, 0), int2( 1, -1)).rgb;
			float3 cBL = PostAA_LDRNatTarg.Load(int3(IN.WPos.xy, 0), int2(-1,  1)).rgb;
			float3 cBR = PostAA_LDRNatTarg.Load(int3(IN.WPos.xy, 0), int2( 1,  1)).rgb;

			cTL = PostAAProcessColorInput(cTL, exposure);
			cTR = PostAAProcessColorInput(cTR, exposure);
			cBL = PostAAProcessColorInput(cBL, exposure);
			cBR = PostAAProcessColorInput(cBR, exposure);

			//WH ocg.polischuk added GetLuminance call
			localContrast = GetLuminance(abs(0.25 * (cTL + cTR + cBR + cBL) - cM));

			cMin = min(min(min(min(cTL, cTR), cBL), cBR), cM);
			cMax = max(max(max(max(cTL, cTR), cBL), cBR), cM);
		}
#endif // SMAA_2TX_SINGLE_TAP_BICUBIC_HISTORY

		// Try to identify subpixel changes
		// WH GM: implicit truncation of vector type, KCD2-448804
		min16float3 prevTL = GetTexture2DLod(PostAA_PrvNatTarg, PostAA_CPSS, float4(tcHistory + texel * float2(-1.0f, -1.0f), 0, 0)).rgb;
		min16float3 prevTR = GetTexture2DLod(PostAA_PrvNatTarg, PostAA_CPSS, float4(tcHistory + texel * float2( 1.0f, -1.0f), 0, 0)).rgb;
		min16float3 prevBL = GetTexture2DLod(PostAA_PrvNatTarg, PostAA_CPSS, float4(tcHistory + texel * float2(-1.0f,  1.0f), 0, 0)).rgb;
		min16float3 prevBR = GetTexture2DLod(PostAA_PrvNatTarg, PostAA_CPSS, float4(tcHistory + texel * float2( 1.0f,  1.0f), 0, 0)).rgb;

		prevTL = PostAAProcessColorInput(prevTL, exposure);
		prevTR = PostAAProcessColorInput(prevTR, exposure);
		prevBL = PostAAProcessColorInput(prevBL, exposure);
		prevBR = PostAAProcessColorInput(prevBR, exposure);

		const float neighborDiff =
			length(clamp(prevTL, cMin, cMax) - prevTL) + length(clamp(prevTR, cMin, cMax) - prevTR) +
			length(clamp(prevBL, cMin, cMax) - prevBL) + length(clamp(prevBR, cMin, cMax) - prevBR);
		
		float clipLength = ClipHistory(cHistory.rgb, cM, cMin, cMax);

		if (neighborDiff < 0.02) clipLength = 0;
	
		// Apply color clipping
		cHistory.rgb = lerp(cHistory.rgb, cM, clipLength);
	
		// How much of History do we want? Low frequency means take more from the History.
		const float cHiFreq = saturate(length(cHistory.rgb - cM) * 10);
		float weight = rcp(lerp(fMaxFramesL, fMaxFramesH, cHiFreq));

#if SMAA_2TX_FLICKER_SUPRESSION
		// Change in local contrast means flickering. Supress flickering by weighing history more strongly.
		// See: "Filmic SMAA Sharp Morphological and Temporal Antialiasing", Jimenez 2016, page 94
		{
			//WH ocg.polischuk added GetLuminance call
			const float localContrastHistory = GetLuminance(abs(0.25 * (prevTL + prevTR + prevBL + prevBR) - cHistory.rgb));

			const float flickerDetection = saturate(4 * abs(localContrast - localContrastHistory));
			const float flickerSupressionWeight = 0.03;
			weight = lerp(weight, flickerSupressionWeight, flickerDetection);
		}
#endif // SMAA_2TX_FLICKER_SUPRESSION

		OUT.Color.rgb = PostAAProcessColorOutput(lerp(cHistory.rgb, cM, weight), exposure);
		OUT.Color.a = 0;

#endif
	}

	return OUT;
}

////////////////////////////////////////////////////////////////////////////////////////////////////
// SMAA

Texture2D<float3> LumEdSMAA_Source         : register(t0);
Texture2D<float2> LumEdSMAA_SceneLuminance : register(t1);

// medium quality
#define SMAA_MAX_SEARCH_STEPS 8
#define SMAA_MAX_SEARCH_STEPS_DIAG 0
#define SMAA_CORNER_ROUNDING 0

// high quality
//#define SMAA_MAX_SEARCH_STEPS 16
//#define SMAA_MAX_SEARCH_STEPS_DIAG 8
//#define SMAA_CORNER_ROUNDING 25

#define SMAA_AREATEX_MAX_DISTANCE 16
#define SMAA_AREATEX_MAX_DISTANCE_DIAG 20

#define SMAA_AREATEX_SUBTEX_SIZE 0.1428571

#define SCALE_PIXELSIZE 2

float2 LumaEdgeDetectionSMAA_PS(vtxOut IN) : SV_Target
{
	const int3 vPixCoord = int3(IN.WPos.xy, 0);

	const float sceneIlluminance = LumEdSMAA_SceneLuminance.Load(int3(0, 0, 0)).y;
	const float exposure = ComputeExposure(sceneIlluminance, HDREyeAdaptation);

	// Calculate lumas:
	const half3 weights = GetLuminanceWeights();
	// WH[TBa]: implicit truncation of vector type, KCD2-448804
	half L     = dot(PostAAProcessColorInput(LumEdSMAA_Source.Load(vPixCoord, int2( 0, 0)), exposure), weights).r;
	half Lleft = dot(PostAAProcessColorInput(LumEdSMAA_Source.Load(vPixCoord, int2(-1, 0)), exposure), weights).r;
	half Ltop  = dot(PostAAProcessColorInput(LumEdSMAA_Source.Load(vPixCoord, int2(0, -1)), exposure), weights).r;

	// We do the usual threshold:
	half4 delta;
	delta.xy = abs(L.xx - half2(Lleft, Ltop));
	half2 edges = step(vParams.x, delta.xy);

	// Then discard if there is no edge:
	if (dot(edges, 1.0h) == 0.0h)
		discard;// this supported on cg ? else clip(-1)

	// Calculate right and bottom deltas:
	// WH[TBa]: implicit truncation of vector type, KCD2-448804
#if %_RT_SAMPLE1
	half Lright   = dot(PostAAProcessColorInput(LumEdSMAA_Source.Load(vPixCoord, int2(1, 0)), exposure), weights).r;
	half Lbottom  = dot(PostAAProcessColorInput(LumEdSMAA_Source.Load(vPixCoord, int2(0, 1)), exposure), weights).r;
#else
	half Lright   = SRGBToLinearApproximation(LumEdSMAA_Source.Load(vPixCoord, int2(1, 0)), weights).r;
	half Lbottom  = SRGBToLinearApproximation(LumEdSMAA_Source.Load(vPixCoord, int2(0, 1)), weights).r;
#endif
	delta.zw = abs(L.xx - half2(Lright, Lbottom));

	// Calculate the maximum delta in the direct neighborhood:
	half maxDelta = max(max(max(delta.x, delta.y), delta.z), delta.w);

	// Calculate left-left and top-top deltas:
	// WH[TBa]: implicit truncation of vector type, KCD2-448804
#if %_RT_SAMPLE1
	half Lleftleft = dot(PostAAProcessColorInput(LumEdSMAA_Source.Load(vPixCoord, int2(-2, 0)), exposure), weights).r;
	half Ltoptop   = dot(PostAAProcessColorInput(LumEdSMAA_Source.Load(vPixCoord, int2(0, -2)), exposure), weights).r;
#else
	half Lleftleft = SRGBToLinearApproximation(LumEdSMAA_Source.Load(vPixCoord, int2(-2, 0)), weights).r;
	half Ltoptop   = SRGBToLinearApproximation(LumEdSMAA_Source.Load(vPixCoord, int2(0, -2)), weights).r;
#endif
	delta.zw = abs(half2(Lleft, Ltop) - half2(Lleftleft, Ltoptop));

	// Calculate the final maximum delta:
	maxDelta = max(max(maxDelta, delta.z), delta.w);
	edges.xy *= step(0.5 * maxDelta, delta.xy);

	return edges;
}

// Diagonal Search Functions

#if SMAA_MAX_SEARCH_STEPS_DIAG || SMAA_FORCE_DIAGONAL_DETECTION

// These functions allows to perform diagonal pattern searches. 
short SMAASearchDiag1(Texture2D<float2> edgesTex, short2 vPixCoord, short2 dir, bool c)
{
	short2 offset = dir;
	float2 e = 0;
	short i = 0;
	for (i = 0; i < SMAA_MAX_SEARCH_STEPS_DIAG; i++) 
	{
		e.rg = edgesTex.Load(int3(vPixCoord, 0), offset).rg;
		[flatten] if (dot(e, 1.0) < 1.9) break;
		offset += dir;
	}
	return i + (e.g > 0.9) && c;
}

short SMAASearchDiag2(Texture2D<float2> edgesTex, short2 vPixCoord, short2 dir, bool c) 
{
	short2 offset = dir;
	float2 e = 0;
	short i = 0;
	for (i = 0; i < SMAA_MAX_SEARCH_STEPS_DIAG; i++) 
	{
		e.g = edgesTex.Load(int3(vPixCoord, 0), offset).g;
		e.r = edgesTex.Load(int3(vPixCoord, 0), offset + int2(1, 0)).r;
		[flatten] if (dot(e, 1.0) < 1.9) break;
		offset += dir;
	}
	return i + (e.g > 0.9) && c;
}

float2 SMAAAreaDiag(Texture2D<float4> areaTex, SamplerState sampSt, short2 distance, float2 e, float offset) 
{
	float2 texcoord = SMAA_AREATEX_MAX_DISTANCE_DIAG * e + distance;

	float2 SMAA_AREATEX_PIXEL_SIZE = 1.0 / float2(160.0, 560.0);

	// We do a scale and bias for mapping to texel space:
	texcoord = SMAA_AREATEX_PIXEL_SIZE * texcoord + (0.5 * SMAA_AREATEX_PIXEL_SIZE);

	// Diagonal areas are on the second min16float of the texture:
	texcoord.x += 0.5;

	// Move to proper place, according to the subpixel offset:
	texcoord.y += SMAA_AREATEX_SUBTEX_SIZE * offset;

	return GetTexture2DLod(areaTex, sampSt, float4(texcoord, 0, 0) ).rg;
}

//This searches for diagonal patterns and returns the corresponding weights.
float2 SMAACalculateDiagWeights(Texture2D<float2> edgesTex, SamplerState sampStE, Texture2D<float4>  areaTex, SamplerState sampStA, short2 vPixCoord, float4 ScreenSize, float2 texcoord, float2 e, min16float4 subsampleIndices) 
{
	float2 weights = 0.0;
	
	float right = edgesTex.Load(int3(vPixCoord, 0), int2(1, 0)).r;
	short2 d;

	d.x = e.r ? SMAASearchDiag1(edgesTex, vPixCoord, short2(-1, 1), true) : 0;
	d.y =       SMAASearchDiag1(edgesTex, vPixCoord, short2(1, -1), false);

	[branch]
	if (d.r + d.g > 2)  // d.r + d.g + 1 > 3
	{ 
		short4 coords = vPixCoord.xyxy + short4(-d.r, d.r, d.g, -d.g);

		float4 c;
		c.x = edgesTex.Load(int3(coords.xy, 0), int2(-1,  0)).g;
		c.y = edgesTex.Load(int3(coords.xy, 0), int2( 0,  0)).r;
		c.z = edgesTex.Load(int3(coords.zw, 0), int2( 1,  0)).g;
		c.w = edgesTex.Load(int3(coords.zw, 0), int2( 1, -1)).r;
		float2 e = 2.0 * c.xz + c.yw;
		e *= step(d.rg, SMAA_MAX_SEARCH_STEPS_DIAG - 1);

		weights += SMAAAreaDiag(areaTex, sampStA, d, e, subsampleIndices.z);
	}

	d.x =         SMAASearchDiag2(edgesTex, vPixCoord, short2(-1, -1), false);
	d.y = right ? SMAASearchDiag2(edgesTex, vPixCoord, short2( 1,  1), true) : 0;

	[branch]
	if (d.r + d.g > 2)  // d.r + d.g + 1 > 3
	{ 
		short4 coords = vPixCoord.xyxy + short4(-d.r, -d.r, d.g, d.g);

		float4 c;
		c.x  = edgesTex.Load(int3(coords.xy, 0), int2(-1,  0)).g;
		c.y  = edgesTex.Load(int3(coords.xy, 0), int2( 0, -1)).r;
		c.zw = edgesTex.Load(int3(coords.zw, 0), int2( 1,  0)).gr;
		float2 e = 2.0 * c.xz + c.yw;
		e *= step(d.rg, SMAA_MAX_SEARCH_STEPS_DIAG - 1);

		weights += SMAAAreaDiag(areaTex, sampStA, d, e, subsampleIndices.w).gr;
	}

	return weights;
}

#endif

// Horizontal/Vertical Search Functions
float SMAASearchLength(Texture2D<float4> searchTex, SamplerState sampStS, float2 e, float bias, float scale) 
{
  e.r = bias + e.r * scale;
  return 255.0 * GetTexture2DLod(searchTex, sampStS, float4(e, 0, 0)).r;//r;
}

float SMAASearchXLeft(Texture2D<float2> edgesTex, SamplerState sampStE, Texture2D<float4> searchTex, SamplerState sampStS, float4 ScreenSize, float2 texcoord, float end) 
{   
  float2 e = float2(0.0, 1.0);
  while (texcoord.x > end && 
         e.g > 0.8281 && // Is there some edge not activated?
         e.r == 0.0) { // Or is there a crossing edge that breaks the line?
      e = GetTexture2DLod(edgesTex, sampStE, float4(texcoord, 0, 0)).rg;
      texcoord -= float2(2.0, 0.0) * ScreenSize.zw;
  }

  // We correct the previous (-0.25, -0.125) offset we applied:
  texcoord.x += 0.25 * ScreenSize.z;

  // The searches are bias by 1, so adjust the coords accordingly:
  texcoord.x += ScreenSize.z;

  // Disambiguate the length added by the last step:
  texcoord.x += 2.0 * ScreenSize.z; // Undo last step
  texcoord.x -= ScreenSize.z * SMAASearchLength(searchTex, sampStS, e, 0.0, 0.5);

  return texcoord.x;
}

float SMAASearchXRight(Texture2D<float2> edgesTex, SamplerState sampStE, Texture2D<float4> searchTex, SamplerState sampStS, float4 ScreenSize, float2 texcoord, float end) 
{
	//PS_ScreenSize.zw *= SCALE_PIXELSIZE;

  float2 e = float2(0.0, 1.0);
  while (texcoord.x < end && 
         e.g > 0.8281 && // Is there some edge not activated?
         e.r == 0.0) { // Or is there a crossing edge that breaks the line?
      e = GetTexture2DLod(edgesTex, sampStE, float4(texcoord, 0, 0)).rg;
      texcoord += float2(2.0, 0.0) * ScreenSize.zw;
  }

  texcoord.x -= 0.25 * ScreenSize.z;
  texcoord.x -= ScreenSize.z;
  texcoord.x -= 2.0 * ScreenSize.z;
  texcoord.x += ScreenSize.z * SMAASearchLength(searchTex, sampStS, e, 0.5, 0.5);
  return texcoord.x;
}

float SMAASearchYUp(Texture2D<float2> edgesTex, SamplerState sampStE, Texture2D<float4> searchTex, SamplerState sampStS, float4 ScreenSize, float2 texcoord, float end)
{
  float2 e = float2(1.0, 0.0);
  while (texcoord.y > end && 
         e.r > 0.8281 && // Is there some edge not activated?
         e.g == 0.0) { // Or is there a crossing edge that breaks the line?
      e = GetTexture2DLod(edgesTex, sampStE, float4(texcoord, 0, 0)).rg;
      texcoord -= float2(0.0, 2.0) * ScreenSize.zw;
  }

  texcoord.y += 0.25 * ScreenSize.w;
  texcoord.y += ScreenSize.w;
  texcoord.y += 2.0 * ScreenSize.w;
  texcoord.y -= ScreenSize.w * SMAASearchLength(searchTex, sampStS, e.gr, 0.0, 0.5);
  return texcoord.y;
}

float SMAASearchYDown(Texture2D<float2> edgesTex, SamplerState sampStE, Texture2D<float4> searchTex, SamplerState sampStS, float4 ScreenSize, float2 texcoord, float end) 
{
  float2 e = float2(1.0, 0.0);
  while (texcoord.y < end && 
         e.r > 0.8281 && // Is there some edge not activated?
         e.g == 0.0) { // Or is there a crossing edge that breaks the line?
      e = GetTexture2DLod(edgesTex, sampStE, float4(texcoord, 0, 0)).rg;
      texcoord += float2(0.0, 2.0) * ScreenSize.zw;
  }
  
  texcoord.y -= 0.25 * ScreenSize.w;
  texcoord.y -= ScreenSize.w;
  texcoord.y -= 2.0 * ScreenSize.w;
  texcoord.y += ScreenSize.w * SMAASearchLength(searchTex, sampStS, e.gr, 0.5, 0.5);
  return texcoord.y;
}

//Ok, we have the distance and both crossing edges. So, what are the areas
//at each side of current edge? 
float2 SMAAArea(Texture2D<float4> areaTex, SamplerState sampStA, float2 distance, float e1, float e2, float offset) 
{
  // Rounding prevents precision errors of bilinear filtering:
  float2 texcoord = SMAA_AREATEX_MAX_DISTANCE * round(4.0 * float2(e1, e2)) + distance;
  
	float2 SMAA_AREATEX_PIXEL_SIZE = 1.0 / float2(160.0, 560.0);

  // We do a scale and bias for mapping to texel space:
  texcoord = SMAA_AREATEX_PIXEL_SIZE * texcoord + (0.5 * SMAA_AREATEX_PIXEL_SIZE);

  // Move to proper place, according to the subpixel offset:
  texcoord.y += SMAA_AREATEX_SUBTEX_SIZE * offset;

  return GetTexture2DLod(areaTex, sampStA, float4(texcoord, 0, 0)).rg;
}

// Corner Detection Functions
void SMAADetectHorizontalCornerPattern(Texture2D<float2> edgesTex, SamplerState sampStE, inout float2 weights, float4 ScreenSize, float2 texcoord, float2 d) 
{
#if SMAA_CORNER_ROUNDING || SMAA_FORCE_CORNER_DETECTION

    float4 coords = mad(float4(d.x, 0.0, d.y, 0.0),
                        ScreenSize.zwzw, texcoord.xyxy);
    float2 e;
    e.r = GetTexture2DLod(edgesTex, sampStE, float4(coords.xy + float2(0.0,  1.0) * ScreenSize.zw, 0, 0) ).r;
    bool left = abs(d.x) < abs(d.y);
    e.g = GetTexture2DLod(edgesTex, sampStE, float4(coords.xy + float2(0.0, -2.0)* ScreenSize.zw, 0, 0) ).r;
    if (left) 
			weights *= saturate(SMAA_CORNER_ROUNDING / 100.0 + 1.0 - e);

    e.r = GetTexture2DLod(edgesTex, sampStE, float4(coords.zw + float2(1.0,  1.0)* ScreenSize.zw, 0, 0) ).r;
    e.g = GetTexture2DLod(edgesTex, sampStE, float4(coords.zw + float2(1.0, -2.0)* ScreenSize.zw, 0, 0) ).r;
    if (!left) 
			weights *= saturate(SMAA_CORNER_ROUNDING / 100.0 + 1.0 - e);

#endif
}

void SMAADetectVerticalCornerPattern(Texture2D<float2> edgesTex, SamplerState sampStE, inout float2 weights, float4 ScreenSize, float2 texcoord, float2 d) 
{
#if SMAA_CORNER_ROUNDING || SMAA_FORCE_CORNER_DETECTION

    float4 coords = mad(float4(0.0, d.x, 0.0, d.y),
                        ScreenSize.zwzw, texcoord.xyxy);
    float2 e;
    e.r = GetTexture2DLod(edgesTex, sampStE, float4(coords.xy+float2( 1.0, 0.0)*ScreenSize.zw, 0, 0) ).g;
    bool left = abs(d.x) < abs(d.y);
    e.g = GetTexture2DLod(edgesTex, sampStE, float4(coords.xy+float2(-2.0, 0.0)*ScreenSize.zw, 0, 0) ).g;
    if (left) 
			weights *= saturate(SMAA_CORNER_ROUNDING / 100.0 + 1.0 - e);

    e.r = GetTexture2DLod(edgesTex, sampStE, float4(coords.zw+float2( 1.0, 1.0)*ScreenSize.zw, 0, 0) ).g;
    e.g = GetTexture2DLod(edgesTex, sampStE, float4(coords.zw+float2(-2.0, 1.0)*ScreenSize.zw, 0, 0) ).g;
    if (!left) 
			weights *= saturate(SMAA_CORNER_ROUNDING / 100.0 + 1.0 - e);

#endif
}

Texture2D<float2> BlndWgtSMAA_Edge           : register(t0); 
Texture2D<float4> BlndWgtSMAA_Area           : register(t1); 
SamplerState BlndWgtSMAA_EdSampler           : register(s1); // linearclamp

Texture2D<float4> BlndWgtSMAA_Srch           : register(t2); 
SamplerState BlndWgtSMAA_SrSampler           : register(s0); // pointclamp

// Second pass: Blending Weight Calculation
pixout BlendWeightSMAA_PS(vtxOut IN)
{
	pixout OUT = (pixout) 0;
	// tex0 = edgesTex
	// tex1 = areaTex
	// tex2 = searchTex

  float4 weights = 0.0;
	
	// todo prebake on vs
	float4 ScreenSize = PS_ScreenSize;  //PS_ScreenSize cannot be modified unless Compatibility Mode is on!!
	ScreenSize.zw *= SCALE_PIXELSIZE;

	float2 pixcoord = IN.WPos.xy;	
	float4 offset[3] =
	{
		float4(IN.baseTC.xyxy + float4(-0.25, -0.125,  1.25, -0.125) * ScreenSize.zwzw),
		float4(IN.baseTC.xyxy + float4(-0.125, -0.25, -0.125,  1.25) * ScreenSize.zwzw),
		float4(IN.baseTC.xyxy)
	};

	offset[2] = float4(offset[0].xz, offset[1].yw) + float4(-2, 2, -2, 2) * ScreenSize.zzww * SMAA_MAX_SEARCH_STEPS;

	const short2 vPixCoord = short2(IN.WPos.xy);
	float2 e = BlndWgtSMAA_Edge.Load(int3(vPixCoord, 0));
	const float4 vSubSampleIndices = 0;

  [branch]
  if (e.g > 0.0h) // Edge at north
	{ 
      #if SMAA_MAX_SEARCH_STEPS_DIAG || SMAA_FORCE_DIAGONAL_DETECTION
      weights.rg = SMAACalculateDiagWeights(BlndWgtSMAA_Edge, BlndWgtSMAA_EdSampler, BlndWgtSMAA_Area, BlndWgtSMAA_EdSampler, vPixCoord, ScreenSize, IN.baseTC.xy, e, vSubSampleIndices);

      // We give priority to diagonals, so if we find a diagonal we skip 
      // horizontal/vertical processing.
      [branch]
      if (dot(weights.rg, 1.0) == 0.0) {

      #endif

      float2 d;

      // Find the distance to the left:
      float2 coords;
      coords.x = SMAASearchXLeft(BlndWgtSMAA_Edge, BlndWgtSMAA_EdSampler, BlndWgtSMAA_Srch, BlndWgtSMAA_SrSampler, ScreenSize, offset[0].xy, offset[2].x);
      coords.y = offset[1].y;
      d.x = coords.x;

      // Now fetch the left crossing edges, two at a time using bilinear
      // filtering. Sampling at -0.25 (see @CROSSING_OFFSET) enables to
      // discern what value each edge has:
      float e1 = GetTexture2DLod(BlndWgtSMAA_Edge, BlndWgtSMAA_EdSampler, float4(coords, 0, 0)).r; //IN.baseTC.xy

      // Find the distance to the right:
      coords.x = SMAASearchXRight(BlndWgtSMAA_Edge, BlndWgtSMAA_EdSampler, BlndWgtSMAA_Srch, BlndWgtSMAA_SrSampler, ScreenSize, offset[0].zw, offset[2].y);
      d.y = coords.x; //IN.baseTC.x;

      // We want the distances to be in pixel units (doing this here allow to
      // better interleave arithmetic and memory accesses):
      d = d / ScreenSize.z - pixcoord.x;

      // SMAAArea below needs a sqrt, as the areas texture is compressed 
      // quadratically:
      float2 sqrt_d = sqrt(abs(d));

      // Fetch the right crossing edges:
      float e2 = GetTexture2DLod(BlndWgtSMAA_Edge, BlndWgtSMAA_EdSampler, float4(coords + float2(1, 0) * ScreenSize.zw, 0, 0)).r;; //IN.baseTC.xy

      // Ok, we know how this pattern looks like, now it is time for getting
      // the actual area:
      weights.rg = SMAAArea(BlndWgtSMAA_Area, BlndWgtSMAA_EdSampler, sqrt_d, e1, e2, vSubSampleIndices.y);

      // Fix corners:
      SMAADetectHorizontalCornerPattern(BlndWgtSMAA_Edge, BlndWgtSMAA_EdSampler, weights.rg, ScreenSize, IN.baseTC.xy, d); //texcoord

      #if SMAA_MAX_SEARCH_STEPS_DIAG || SMAA_FORCE_DIAGONAL_DETECTION

      } 
			else
			{
          e.r = 0.0; // Skip vertical processing.
			}

      #endif
  }

  [branch]
  if (e.r > 0.0f)		// Edge at west
	{ 
      float2 d;

      // Find the distance to the top:
      float2 coords;
      coords.y = SMAASearchYUp(BlndWgtSMAA_Edge, BlndWgtSMAA_EdSampler, BlndWgtSMAA_Srch, BlndWgtSMAA_SrSampler, ScreenSize, offset[1].xy, offset[2].z);
      coords.x = offset[0].x;
      d.x = coords.y;

      // Fetch the top crossing edges:
      float e1 = GetTexture2DLod(BlndWgtSMAA_Edge, BlndWgtSMAA_EdSampler, float4(coords, 0, 0)).g;

      // Find the distance to the bottom:
      coords.y = SMAASearchYDown(BlndWgtSMAA_Edge, BlndWgtSMAA_EdSampler, BlndWgtSMAA_Srch, BlndWgtSMAA_SrSampler, ScreenSize, offset[1].zw, offset[2].w);
      d.y = coords.y;

      // We want the distances to be in pixel units:
      d = d / ScreenSize.w - pixcoord.y;

      // SMAAArea below needs a sqrt, as the areas texture is compressed 
      // quadratically:
      float2 sqrt_d = sqrt(abs(d));

      // Fetch the bottom crossing edges:
      float e2 = GetTexture2DLod(BlndWgtSMAA_Edge, BlndWgtSMAA_EdSampler, float4(coords + float2(0, 1)*ScreenSize.zw, 0, 0)).g;

      // Get the area for this direction:
      weights.ba = SMAAArea(BlndWgtSMAA_Area, BlndWgtSMAA_EdSampler, sqrt_d, e1, e2, vSubSampleIndices.x);

      // Fix corners:
      SMAADetectVerticalCornerPattern(BlndWgtSMAA_Edge, BlndWgtSMAA_EdSampler, weights.ba, ScreenSize, IN.baseTC.xy, d);
  }

	OUT.Color = weights;//*10;

  return OUT;
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

Texture2D<float4> NbrBlndSMAA_Wgt            : register(t0);
Texture2D<float4> NbrBlndSMAA_Trg            : register(t1);
Texture2D<float2> NbrBlndSMAA_SceneLuminance : register(t2);

SamplerState NBRBlndSMAA_TSampler            : register(s1); // pointclamp

pixout NeighborhoodBlendingSMAA_PS(vtxOut IN)
{
	pixout OUT = (pixout) 0;
	
	const int3 vPixCoord = int3(IN.WPos.xy, 0);
	const float sceneIlluminance = NbrBlndSMAA_SceneLuminance.Load(int3(0, 0, 0)).y;
	const float exposure = ComputeExposure(sceneIlluminance, HDREyeAdaptation);

	// Fetch the blending weights for current pixel:
	float4 topLeft = NbrBlndSMAA_Wgt.Load(vPixCoord);
	float bottom   = NbrBlndSMAA_Wgt.Load(vPixCoord, int2(0, 1)).g;
	float right    = NbrBlndSMAA_Wgt.Load(vPixCoord, int2(1, 0)).a;
	float4 a = float4(topLeft.r, bottom, topLeft.b, right);

	[branch]
	if (dot(a, 1.0) < 1e-5)
	{
		OUT.Color = NbrBlndSMAA_Trg.Load(vPixCoord);
		return OUT;
	}
	else 
	{
		// Up to 4 lines can be crossing a pixel (one through each edge). We
		// favor blending by choosing the line with the maximum weight for each
		// direction:
		float2 offset;
		offset.x = a.a > a.b ? a.a : -a.b; // left vs. right 
		offset.y = a.g > a.r ? a.g : -a.r; // top vs. bottom

		// Then we go in the direction that has the maximum weight:
		if (abs(offset.x) > abs(offset.y)) // horizontal vs. vertical
			offset.y = 0.0;
		else
			offset.x = 0.0;

		// Fetch the opposite color and lerp by hand:
		float4 C =   NbrBlndSMAA_Trg.Load(vPixCoord);
		float4 Cop = NbrBlndSMAA_Trg.Load(vPixCoord + int3(sign(offset), 0));
			
		C.rgb   = PostAAProcessColorInput(C.rgb,   exposure);
		Cop.rgb = PostAAProcessColorInput(Cop.rgb, exposure);

		float s = abs(offset.x) > abs(offset.y) ? abs(offset.x) : abs(offset.y);
		OUT.Color = lerp(C, Cop, s);

		// WH[MMatous]: implicit truncation of vector type, KCD2-448804
		OUT.Color.rgb = PostAAProcessColorOutput(OUT.Color.rgb, exposure);

		return OUT;
	}

	return OUT;
}

////////////////// technique /////////////////////

technique PostAA
{
  pass p0
  {
    VertexShader = PostAA_VS() PostAA_VS;
    PixelShader = PostAA_PS() PostAA_PS;
    CullMode = None;        
  }
}

