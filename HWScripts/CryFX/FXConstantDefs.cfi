// Keep in sync with MAX_JOINT_AMOUNT in CryCommon/ProjectDefines.h
 #define MAX_BONES 768
 #define MAX_NUM_BONES_PER_GROUP 250
 #define MAX_NUM_BONES_PER_GROUP_WITH_MB 125

//============================================================================
//=== Uniform parameters =====================================================

// Parameter semantic prefixes:
// PF - Per-Frame
// PB - Per-Batch
// PI - Per-Instance
// PM - Per-Material


// Per-Material Constant Buffer - Fixed constants
#define REG_PM_BINDLESS_0  c0
#define REG_PM_BINDLESS_1  c1
#define REG_PM_BINDLESS_2  c2
#define REG_PM_BINDLESS_3  c3

#define REG_PM_DIFFUSE_COL          c4
#define REG_PM_SPECULAR_COL         c5
#define REG_PM_EMISSIVE_COL         c6
#define REG_PM_TCM_MATRIX           c7
#define REG_PM_DEFORM_WAVE          c11
#define REG_PM_DETAIL_TILING        c12
#define REG_PM_SILPOM_DETAIL_PARAMS c13
#define REG_PM_CUSTOM_TILING_OFFSET_WH c14

// Per-Material Constant Buffer - Tweakables in cfi files
#define REG_PM_PARAM_INCL_0  c15
#define REG_PM_PARAM_INCL_1  c16
#define REG_PM_PARAM_INCL_2  c17
#define REG_PM_PARAM_INCL_3  c18

// Per-Material Constant Buffer - Tweakables in cfx files
#define REG_PM_PARAM_0  c19
#define REG_PM_PARAM_1  c20
#define REG_PM_PARAM_2  c21
#define REG_PM_PARAM_3  c22
#define REG_PM_PARAM_4  c23
#define REG_PM_PARAM_5  c24
#define REG_PM_PARAM_6  c25
#define REG_PM_PARAM_7  c26
#define REG_PM_PARAM_8  c27

//============================================================================
// WH[TBa,bzapotocky]: additional registers!!!
//============================================================================
#define REG_PM_PARAM_9 c28
#define REG_PM_PARAM_10 c29
#define REG_PM_PARAM_11 c30
#define REG_PM_PARAM_12 c31
#define REG_PM_PARAM_13 c32
#define REG_PM_PARAM_14 c33
#define REG_PM_PARAM_15 c34

//============================================================================

float4   MatDifColor                 : PM_MatDiffuseColor             < register = REG_PM_DIFFUSE_COL; >;
float4   MatSpecColor                : PM_MatSpecularColor            < register = REG_PM_SPECULAR_COL; >;
float4   MatEmissiveColor            : PM_MatEmissiveColor            < register = REG_PM_EMISSIVE_COL; >;
float4x4 CM_MatrixTCM                : PM_MatMatrixTCM                < register = REG_PM_TCM_MATRIX; >;
float4   CM_DeformWave               : PM_MatDeformWave               < register = REG_PM_DEFORM_WAVE; >;
float4   CM_DetailTilingAndAlphaRef  : PM_MatDetailTilingAndAlphaRef  < register = REG_PM_DETAIL_TILING; >;
float4   CM_SilPomDetailParams       : PM_MatSilPomDetailParams       < register = REG_PM_SILPOM_DETAIL_PARAMS; >;
float4   CM_CustomTilingOffsetWH     : PM_MatEmittanceTilingWH        < register = REG_PM_CUSTOM_TILING_OFFSET_WH; >;


