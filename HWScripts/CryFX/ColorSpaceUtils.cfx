#include "Common.cfi"
#include "CommonColorTransforms.cfi"
#include "PostEffectsLib.cfi"
#include "imageLib.cfi"

// Shader global descriptions
float Script : STANDARDSGLOBAL
<
	string Script =
	  "NoPreview;"
	  "LocalConstants;"
	  "ShaderDrawType = Custom;"
	  "ShaderType = PostProcess;"
>; 

////////////////// samplers //////////////////////

Texture2D<min16float4> Tx2Tx_Source     : register(t0); 
Texture2D<min16float4> UITex_Source     : register(t1); 
SamplerState Tx2Tx_Sampler              : register(s0);

///////////////// vertex shader //////////////////

struct vtxOutTexToTex
{
	float4 HPosition  : SV_POSITION;
	float2 baseTC     : TEXCOORDN;
	
	MSAA_SAMPLE_INDEX_PS
};

vtxOutTexToTex TexToTexVS(uint VertexID : SV_VertexID)
{
	vtxOutTexToTex OUT; 
	OUT.HPosition = GetHPos_FromTriVertexID(VertexID);
	float2 baseTC = GetBaseTC_FromTriVertexID(VertexID);
	OUT.baseTC.xy = baseTC;
	return OUT;
}

/////////// Output Device Transform //////////////
// WH[DH]: Composite HDR scene color and LDR UI

float4 HDRParams;

#define SideBySideBalance                    HDRParams.x
#define UIBrightness                         HDRParams.y
#define SoftwareGamma                        HDRParams.z

// Alpha is premultiplied in the UI, so we omit alpha from the standard (source.rgb * source.a)
float3 AlphaComposite(in float4 source, in float4 destination)
{
	return (source.rgb * source.a) + ((1.0f - source.a) * destination.rgb);
}

float3 HDRAlphaComposite(in float4 source, in float4 destination, float brightness)
{
	// A fast inversable tonemapper lets us composite UI elements onto the HDR image
	destination.rgb = LinearTonemap(destination.rgb);

	// WH[DH]: Composite UI with mismatched gamma curve
	source.rgb = LinearTonemap(Gamma22ToLinear(source.rgb) * brightness);
	destination.rgb = AlphaComposite(source, destination);
	destination.rgb = InverseLinearTonemap(destination.rgb);

	return destination.rgb;
}

void ApplyRec2020(inout float4 color)
{
#if %_RT_SAMPLE1 // Rec2020 w. ST.2084 EOTF
		color.rgb = Rec709ToRec2020(color.rgb);
		color.rgb = LinearToST2084(color.rgb * HDR_WHITE_VALUE);
#endif
}

pixout OutputDeviceTransformPS(vtxOutTexToTex IN)
{
	pixout OUT;

	float4 color   = GetTexture2D(Tx2Tx_Source, Tx2Tx_Sampler, IN.baseTC.xy);
	float4 uiColor = GetTexture2D(UITex_Source, Tx2Tx_Sampler, IN.baseTC.xy);

#if %_RT_SAMPLE0 // HDR Enabled Output Device

#if %_RT_SAMPLE4 // Linear Encoded HDR 0-10,000 nits
	color.rgb *= HDR_NORMALIZATION_FACTOR;
#endif

	// WH[DH]: The input color is in the Rec2020 color space
#if %_RT_SAMPLE1 // Rec2020 w. ST.2084 EOTF
	uiColor.rgb = Rec709ToRec2020(uiColor.rgb);
#else
	color.rgb = Rec2020ToRec709(color.rgb);
#endif

	color.rgb = HDRAlphaComposite(uiColor, color, UIBrightness);

#if %_RT_SAMPLE1 // Rec2020 w. ST.2084 EOTF
	color.rgb = LinearToST2084(color.rgb * HDR_WHITE_VALUE);
#endif

#if %_RT_SAMPLE4 // Linear Encoded HDR 0-10,000 nits
	color.rgb /= HDR_NORMALIZATION_FACTOR;
#endif

#else // LDR

	// Do this before compositing UI, gamma should not affect it
	color.rgb = LinearToSRGB(color.rgb);
	color.rgb = pow(color.rgb, SoftwareGamma);

	color.rgb = AlphaComposite(uiColor, color);

	// Apply dithering to remove banding (in non-linear space)
#if %_RT_SAMPLE3
	ApplyRandomDithering(color.rgb, IN.HPosition.xy);
#endif

#endif

	OUT.Color = color;
	return OUT;
}


////////////////// technique /////////////////////

technique OutputDeviceTransform
{
	pass p0
	{
		VertexShader = TexToTexVS();
		PixelShader = OutputDeviceTransformPS() OutputDeviceTransform;
		CullMode = None;
	}
}