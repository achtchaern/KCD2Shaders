#define MAX_FRACTIONAL_8_BIT        (255.0f / 256.0f)
#define MIDPOINT_8_BIT              (127.0f / 255.0f)
#define TWO_BITS_EXTRACTION_FACTOR  (3.0f + MAX_FRACTIONAL_8_BIT)
#define G_EPSILON                   1e-4f

#define short  min16int
#define short2 min16int2
#define short3 min16int3
#define short4 min16int4

////////////////////////////////////////////////////////////////////////////////////////////////////
// Basic math tools

float4 sqr(float4 x)
{
	return x * x;
}

float3 sqr(float3 x)
{
	return x * x;
}

float2 sqr(float2 x)
{
	return x*x;
}

float  sqr(float x)
{ 
	return x*x; 
}

float hmin(float4 c)
{
	float2 d = min(c.xy, c.zw);
	return min(d.x, d.y);
}

float hmax(float4 c)
{
	float2 d = max(c.xy, c.zw);
	return max(d.x, d.y);
}

float hmin(float4 a, float4 b)
{
	return hmin(min(a, b));
}

float hmax(float4 a, float4 b)
{
	return hmax(min(a, b));
}

float2 NRand2( float2 seed, float multiplier )
{
	return frac(sin(dot(seed.xy, float2(34.483, 89.637))) * multiplier * float2(29156.4765, 38273.5639));
}

float3 NRand3( float2 seed )
{
	return frac(sin(dot(seed.xy, float2(34.483, 89.637))) * float3(29156.4765, 38273.5639, 47843.7546));
}

////////////////////////////////////////////////////////////////////////////////////////////////////
// Geometric math

float IntersectAABB(float3 rayDir, float3 rayOrg, float3 boxExt)
{
	if (length(rayDir) < 1e-6) return 1;

	// Intersection using slabs
	float3 rcpDir = rcp(rayDir);
	float3 tNeg = ( boxExt - rayOrg) * rcpDir;
	float3 tPos = (-boxExt - rayOrg) * rcpDir;

	return max(max(min(tNeg.x, tPos.x), min(tNeg.y, tPos.y)), min(tNeg.z, tPos.z));
}

uint selectCubeFace(in float3 rayVec)
{
	float3 dir = abs(rayVec);

	bool3 pmag = bool3(dir.x > dir.y, dir.y > dir.z, dir.x > dir.z);
	bool3 nmag = bool3(dir.x <= dir.y, dir.y <= dir.z, dir.x <= dir.z); 
	bool3 flp  = bool3(rayVec.x == dir.x, rayVec.y == dir.y, rayVec.z == dir.z); 

	uint cubeFace = 
		(pmag.x) * (pmag.z) * (0 + flp.x) +
		(nmag.x) * (pmag.y) * (2 + flp.y) +
		(nmag.z) * (nmag.y) * (4 + flp.z); 
		
	return cubeFace;
}

////////////////////////////////////////////////////////////////////////////////////////////////////
// Blending algorithms

// Reoriented-Normal-Mapping (RNM)
float3 blend_rnm(float3 n1, float3 n2, float blendFactor)
{
    float3 t = n1.xyz * float3(2, 2, 2) + float3(-1, -1, 0);
    float3 u = n2.xyz * float3(-2, -2, 2) + float3(1, 1, -1);
    u.xy *= blendFactor;
    return normalize(t * dot(t, u) - u * t.z);
}

////////////////////////////////////////////////////////////////////////////////////////////////////
// Encoding related math (simple)

float4 RGB10A2_to_RGB10A2f( float4 InColor )
{
	// Shift left 3 bits. This allows us to have the exponent and mantissa on opposite
	// sides of the decimal point for extraction.
	float4 OutColor = InColor * 8.0f;

	// Extract the exponent and mantissa that are now on opposite sides of the decimal point
	float3 e = floor( OutColor.rgb );
	float3 m = frac( OutColor.rgb );
	
	// Perform the 7e3 conversion.  Note that this varies on the value of e for each channel:
	// if e != 0.0f then the correct conversion is (1+m)/8*pow(2,e).
	// else it is (1+m)/8*pow(2,e).  
	OutColor.rgb  = (e == 0.0f) ? 2*m/8 : (1+m)/8 * exp2(e);

	return OutColor;
}

// Encode a float value into 3 bytes (input value should be in the range of [0, 1])
float3 PackFloatToVec3(const float value)
{
	static const float3 bitSh = float3(256.0 * 256.0, 256.0, 1.0);
	static const float3 bitMsk = float3(0.0, 1.0/256.0, 1.0/256.0);
	float3 res = frac(value * bitSh);
	res -= res.xxy * bitMsk;
	return res;
}

float UnpackFloatFromVec3(const float3 value)
{
	static const float3 bitSh = float3(1.0/(256.0*256.0), 1.0/256.0, 1.0);
	return dot(value, bitSh);
}

////////////////////////////////////////////////////////////////////////////////////////////////////
// Color-Space related math

min16float3 GetLuminanceWeights()
{
	return min16float3(0.2126, 0.7152, 0.0722);
}

min16float GetLuminance(min16float3 color)
{
	return dot(color, GetLuminanceWeights());
}

min16float3 EncodeColorYCC(min16float3 col)
{
	min16float3 encodedCol;

	// Y'Cb'Cr'
#if !%CLOTHING_SYSTEM // WH GM: this is included before IllumValidations.cfi so we can't use macros
	//material atlas already uses linear color
	col = sqrt(col);
#endif
	encodedCol.x = dot(min16float3(0.299, 0.587, 0.114), col.rgb);
	encodedCol.y = dot(min16float3(-0.1687, -0.3312, 0.5), col.rgb);
	encodedCol.z = dot(min16float3(0.5, -0.4186, -0.0813), col.rgb);
	
	return min16float3(encodedCol.x, encodedCol.y * MIDPOINT_8_BIT + MIDPOINT_8_BIT, encodedCol.z * MIDPOINT_8_BIT + MIDPOINT_8_BIT);
}

min16float3 DecodeColorYCC( min16float3 encodedCol, const bool useChrominance = true )
{
	encodedCol = min16float3(encodedCol.x, encodedCol.y / MIDPOINT_8_BIT - 1, encodedCol.z / MIDPOINT_8_BIT - 1);
	if (!useChrominance) encodedCol.yz = 0;
	
	// Y'Cb'Cr'
	min16float3 col;
	col.r = encodedCol.x + 1.402 * encodedCol.z;
	col.g = dot( min16float3( 1, -0.3441, -0.7141 ), encodedCol.xyz );
	col.b = encodedCol.x + 1.772 * encodedCol.y;

	return col * col;
}

// WH GM: Compresses color into 2 channels by keeping chrominance only for yellow and red (metals like gold and copper).
min16float2 EncodeColorYCCCompressedWH(min16float3 col)
{
	min16float3 encodedCol;

	// Y'Cb'Cr'
#if !%CLOTHING_SYSTEM // WH GM: this is included before IllumValidations.cfi so we can't use macros
	//material atlas already uses linear color
	col = sqrt(col);
#endif
	encodedCol.x = dot(min16float3(0.299, 0.587, 0.114), col.rgb);
	// Cb range <-0.5, 0> contains color information for yellow. Remap it to <0,1> and throw away the rest.
	// Same as: clamp(dot(min16float3(-0.1687, -0.3312, 0.5), col.rgb), -0.5, 0) * -2;
	encodedCol.y = saturate(dot(min16float3(0.3374, 0.6624, -1), col.rgb));
	// Cr range <0, 0.5> contains color information for red. Remap it to <0,1> and throw away the rest.
	// Same as: clamp(dot(min16float3(0.5, -0.4186, -0.0813), col.rgb), 0, 0.5) * 2; //red
	encodedCol.z = saturate(dot(min16float3(1, -0.8372, -0.1626), col.rgb));

	min16float2 encodedColCompressed;
	encodedColCompressed.x = encodedCol.x; // keep luminance uncompressed
	encodedColCompressed.y = (floor(encodedCol.y * 16) * 16 + floor(encodedCol.z * 16)) / 255; // compress Cb Cr into one channel

	return encodedColCompressed;
}

// WH GM: See comment in EncodeColorYCC2CompressedWH
min16float3 DecodeColorYCCCompressedWH( min16float2 encodedColCompressed, const bool useChrominance = true )
{
	min16float3 encodedCol;
	encodedCol.x = encodedColCompressed.x;
	encodedCol.y = floor(encodedColCompressed.y * 16) / -32; // decompress Cb and remap it back to <-0.5, 0>
	encodedCol.z = frac(encodedColCompressed.y * 16) / 2; // decompress Cr and remap it back to <0, 0.5>

	if (!useChrominance) encodedCol.yz = 0;
	
	// Y'Cb'Cr'
	min16float3 col;
	col.r = encodedCol.x + 1.402 * encodedCol.z;
	col.g = dot( min16float3( 1, -0.3441, -0.7141 ), encodedCol.xyz );
	col.b = encodedCol.x + 1.772 * encodedCol.y;

	return col * col;
}

////////////////////////////////////////////////////////////////////////////////////////////////////
// Gamma-Curve / Transfer-function only (no color-space change and no limited ranges)
min16float3 LinearToSRGB(min16float3 col)
{
	col = saturate(col);
	return (col < 0.0031308) ? 12.92h * col : 1.055h * pow(col, 1.0h / 2.4h) - min16float3(0.055h, 0.055h, 0.055h);
}

min16float3 SRGBToLinear(min16float3 col)
{
	col = saturate(col);
	return (col <= 0.040450h) ? col / 12.92h : pow((col + min16float3(0.055h, 0.055h, 0.055h)) / 1.055h, 2.4h);
}

min16float3 SRGBToLinearApproximation(min16float3 col)
{
	col = saturate(col);
	// http://chilliant.blogspot.com/2012/08/srgb-approximations-for-hlsl.html
	return
		col * (col * (col * 0.305306011h + 0.682171111h) + 0.012522878h);
}

min16float3 SRGBToLinearApproximation(min16float3 col, min16float3 weights)
{
	col = saturate(col);
	// http://chilliant.blogspot.com/2012/08/srgb-approximations-for-hlsl.html
	return
		col.r * (col.r * (col.r * 0.305306011h + 0.682171111h) + 0.012522878h) * weights.r +
		col.g * (col.g * (col.g * 0.305306011h + 0.682171111h) + 0.012522878h) * weights.g +
		col.b * (col.b * (col.b * 0.305306011h + 0.682171111h) + 0.012522878h) * weights.b;
}

// WH[DH]: Gamma 2.2 curve
min16float3 Gamma22ToLinear(min16float3 col)
{
	return pow(col, 2.2f);
}

min16float3 LinearToREC709(min16float3 col)
{
	col = saturate(col);
	return (col < 0.0180000h) ? 4.50h * col : 1.099h * pow(col, 1.0h / 2.4h) - min16float3(0.099h, 0.099h, 0.099h);
}

min16float3 REC709ToLinear(min16float3 col)
{
	col = saturate(col);
	return (col < 0.081000h) ? col / 4.50h : pow((col + min16float3(0.099h, 0.099h, 0.099h)) / 1.099h, 2.4h);
}

// Rec. 2020 defines a nonlinear transfer function for gamma correction that is the same nonlinear transfer function that is used by Rec. 709,
// except that its parameters are given with higher precision
float3 LinearToREC2020(float3 col)
{
	col = saturate(col);
	return (col < 0.018053968510807f) ? 4.50f * col : 1.09929682680944f * pow(col, 1.0h / 2.4f) - float3(0.09929682680944f, 0.09929682680944f, 0.09929682680944f);
}

float3 REC2020ToLinear(float3 col)
{
	col = saturate(col);
	return (col < 0.0812428582986315f) ? col / 4.50f : pow((col + float3(0.09929682680944f, 0.09929682680944f, 0.09929682680944f)) / 1.09929682680944f, 2.4f);
}

// WH[MMatous]: Added for hair tinting
float3 RGB565ToRGB8(int rgb565)
{
	return float3(
		float(rgb565 >> 11) / ((1 << 5) - 1),
		float((rgb565 >> 5) & ((1 << 6) - 1)) / ((1 << 6) - 1),
		float(rgb565 & ((1 << 5) - 1)) / ((1 << 5) - 1));
}

// The color primaries of sRGB and REC709 are the same, REC2020 has distinct color primaries
float3 Convert_REC709toREC2020(half3 col)
{
	return float3(
		0.6274f * col.x + 0.3293f * col.y + 0.0433f * col.z,
		0.0691f * col.x + 0.9195f * col.y + 0.0114f * col.z,
		0.0164f * col.x + 0.0880f * col.y + 0.8956f * col.z);
}

half3 LimitREC709_8Bit(half3 col)
{
	// Technically 0 and 255 are reserved values (timing control values) and the rest is out-of-gammut
	return (16.0 / 255.0) + col.xyz * ((235.0 - 16.0) / 255.0);
}

half3 LimitREC2020_10Bit(half3 col)
{
	// Technically 0-3 and 1020-1023 are reserved values (timing control values) and the rest is out-of-gammut
	return (64.0 / 1024.0) + col.xyz * ((940.0 - 64.0) / 1024.0);
}

half3 LimitREC2020_12Bit(half3 col)
{
	// Technically 0-15 and 4080-4095 are reserved values (timing control values) and the rest is out-of-gammut
	return (256.0 / 4096.0) + col.xyz * ((4080.0 - 256.0) / 4096.0);
}

////////////////////////////////////////////////////////////////////////////////////////////////////
// Backwards-compatibility preserving function-husks

// Common functions
min16float4 EXPAND( min16float4 a )
{
  return a * 2 - 1;
}
min16float3 EXPAND( min16float3 a )
{
  return a * 2 - 1;
}
min16float EXPAND( min16float a )
{
  return a * 2 - 1;
}
min16float2 EXPAND( min16float2 a )
{
  return a * 2 - 1;
}
