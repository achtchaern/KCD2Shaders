///////////////// vertex shader //////////////////

// WH[TomK]: Sparse update shadows motion bias, KCD2-462064
float ShadowMotionBias(float3 motionVec)
{
	float motionBias = CP_ShadowGen_DepthTestBias.y;                  // Const term
	motionBias += CP_ShadowGen_DepthTestBias.z * length(motionVec);   // All directions term
	motionBias += CP_ShadowGen_DepthTestBias.w * max(0, motionVec.z); // Away from camera term

	return clamp(CD_CustomData2.w * motionBias, 0, 3); // Apply instance motion bias coeficient
}

v2f_sh Common_SG_VS(app2vertSGGeneral IN_common)
{
  v2f_sh OUT = (v2f_sh)0; 

  	app2vertSGGeneral IN = IN_common;
#if %TEMP_TERRAIN
	IN.vertCommon.Position.z = IN_common.vertCommon.baseTC.x;
#endif

bool instanceMatrixToWorldSpace = false;
#if %_RT_NEAREST
	// Nearest objects are in camera space, we don't want to render the nearest shadows in camera space
	// so convert to world space
	instanceMatrixToWorldSpace = true;
#endif

  streamPos vertPassPos = (streamPos)0;
  streamPos_FromSG(IN, vertPassPos);
	streamPos vertPassPosPrev = (streamPos) vertPassPos;
  
#if %TEMP_TERRAIN && %_RT_OBJ_IDENTITY
  float4 HPosition = Pos_VS_Terrain(0, g_VS_ViewProjMatr, vertPassPos, true);
#else  
  float4 HPosition = Pos_VS_General(g_VS_ViewProjMatr, vertPassPos, false, instanceMatrixToWorldSpace);
	
	float3 HPositionLin = HPosition.xyz;
	HPositionLin.z /= CP_ShadowGen_FrustumInfo.y;
#endif

#if ENABLE_TESSELLATION && !%_RT_NO_TESSELLATION
	// For shadow gen this is world position (not relative to camera)
	OUT.vView.xyz = vertPassPos.WorldPos.xyz;
	OUT.vNormal.xyz = mul((float3x3)vertPassPos.InstMatrix, vertPassPos.Normal);
#endif

	// RSMs
#if (!ENABLE_TESSELLATION || %_RT_NO_TESSELLATION) && %_RT_SAMPLE4
	#if %_RT_DECAL_TEXGEN_2D
		// tex gen for 2d projected decals
		OUT.baseTC.x = dot( CD_DecalTangent, vertPassPos.Position );
		OUT.baseTC.y = dot( CD_DecalBitangent, vertPassPos.Position );  
	#elif %TEMP_TERRAIN
		// tex coordinates on the sector textures
		OUT.baseTC.xy = float2(Get_SPI_BlendWithTerrainColInfo().zz*vertPassPos.WorldPos.yx+Get_SPI_BlendWithTerrainColInfo().xy);
		OUT.Normal = vertPassPos.Normal;
	#else 
		float3 objSpaceNormal = TangNormalUnnormalized(vertPassPos.Tangent, vertPassPos.Binormal);
		OUT.Normal = mul((float3x3)vertPassPos.InstMatrix, objSpaceNormal);

		// Apply texture modifiers
		float4 baseTC = vertPassPos.baseTC;
		_TCModify(baseTC, baseTC, vertPassPos.Position, OUT.Normal, TS_DIFFUSE);
		OUT.baseTC = baseTC.xy;
	#endif
#endif

#if %_RT_SHADOW_DEPTH_OUTPUT_LINEAR
	#if !%_RT_CUBEMAP0 
	  #if !%_RT_NEAREST
			HPosition.z = HPositionLin.z;	//use linear z-buffer

		#if %TEMP_TERRAIN
			HPosition.z += .002;
			HPosition.z = max(HPosition.z, 0.001);
		#endif

	  #endif

	  #if %_RT_SAMPLE0
		OUT.Depth = HPosition.z + CP_ShadowGen_DepthTestBias.x;
	  #endif

	  #if !%_RT_HW_PCF_COMPARE 
		//perspective interpolation is not needed here
		OUT.Depth = HPosition.z - CP_ShadowGen_FrustumInfo.z; //increase precision around camera
	  #endif
	  
		// WH[TomK]: Apply motion compensation bias, KCD2-462064
		#if (!%_RT_HW_PCF_COMPARE || %_RT_SAMPLE0) && (!%TEMP_TERRAIN || !%_RT_OBJ_IDENTITY)
			float3 HPositionPrevLin = Pos_Prev_VS_Shadow(vertPassPosPrev, false).xyz;
			HPositionPrevLin.z /= CP_ShadowGen_FrustumInfo.y;
			
			OUT.Depth += ShadowMotionBias(HPositionLin - HPositionPrevLin);
		#endif

		#if !%_RT_NEAREST
			HPosition.z *= HPosition.w;   //HPosition.z is linearized already
	  #endif
	#else // LOCAL LIGHT / POINT LIGHT
		float3 HPositionPrevLin = Pos_Prev_VS_Shadow(vertPassPosPrev, false).xyz;
		HPositionPrevLin.z /= CP_ShadowGen_FrustumInfo.y;
			
		OUT.Depth = HPositionLin.z;
		OUT.Depth += CP_ShadowGen_DepthTestBias.x;
		
		OUT.Depth += ShadowMotionBias(HPositionLin - HPositionPrevLin); // WH[TomK]: Motion bias, KCD2-462064
		// WH[TBa]: add second bias for materials without front face culling, KCD2-123979
		#if %_RT_SAMPLE3
			OUT.Depth += CP_ShadowGen_FrustumInfo.w;
		#endif
	//_RT_DIRECTLIGHT
	#endif
#endif

float4 OutBaseTC;
#if !%TEMP_TERRAIN
 #if %_RT_ALPHATEST || %_RT_ALPHABLEND || MATERIAL_ATLAS
  _TCModify(vertPassPos.baseTC, OutBaseTC, vertPassPos.Position, vertPassPos.ObjToTangentSpace[2], TS_DIFFUSE);
	// WH[TBa]: implicit truncation of vector type, KCD2-448804
	OUT.baseTC.xy = OutBaseTC.xy;
 #endif
#endif

#if ENABLE_TESSELLATION && !%_RT_NO_TESSELLATION
  _TCModify(vertPassPos.baseTC, OutBaseTC, vertPassPos.Position, vertPassPos.ObjToTangentSpace[2], TS_DIFFUSE);
	// WH[TBa]: implicit truncation of vector type, KCD2-448804
	OUT.baseTC.xy = OutBaseTC.xy;
#endif

#if %_DS || %_PS || !ENABLE_TESSELLATION || %_RT_NO_TESSELLATION
  OUT.HPosition = HPosition;
#endif  

#if HIDING_GROUPS
	DiscardVertexIfHidden(OUT.HPosition, vertPassPos.Color, true);
#endif

#if MATERIAL_ATLAS
	OUT.featureIndex = DecodeFeatureIndex(vertPassPos.Color);
	DiscardHiddenMaterialAtlasVertex(OUT.HPosition, OUT.featureIndex);
#endif

  return OUT;
}

// Hull shader and domain shader
#include "CommonShadowGenPassTess.cfi"
//////////////////////////////////////

struct pixout_shadow
{
#if (!ENABLE_TESSELLATION || %_RT_NO_TESSELLATION) && %_RT_SAMPLE4
  float4 Color   : SV_Target0;
  min16float4 Normal   : SV_Target1;
#endif

#if %_RT_SHADOW_DEPTH_OUTPUT_LINEAR
	#if %_RT_SAMPLE0
	  float Depth    : SV_DepthGreaterEqual;
	#elif %_RT_HW_PCF_COMPARE && %_RT_CUBEMAP0
	  float Depth    : SV_Depth;
	#endif
#endif
};

///////////////// pixel shader //////////////////
// WH[DH]: Do not use early-z, it causes moire pattern
pixout_shadow Common_SG_PS(v2f_sh IN)
{
	pixout_shadow OUT = (pixout_shadow)0;

#if %_RT_SHADOW_DEPTH_OUTPUT_LINEAR
	// WH[TBa]: also enable slope bias for local lights and increase the upper limit to fix various self-shadowing artifacts
	// _RT_SAMPLE0: Sun shadows
	// _RT_CUBEMAP0: Local lights
	#if %_RT_SAMPLE0 || %_RT_CUBEMAP0
			float fSlopeScale = CP_ShadowGen_FrustumInfo.z;
			float fSlopeClamp = 0.1;
			OUT.Depth = IN.Depth + min( fSlopeScale * max( abs(ddx(IN.Depth)), abs(ddy(IN.Depth)) ), fSlopeClamp);
	#endif
#endif

#if %_RT_ALPHATEST || %_RT_ALPHABLEND || %_RT_SAMPLE4
	#if !%TEMP_TERRAIN
		min16float4 baseColor = GetDiffuseTexBilinear(diffuseTex, IN.baseTC.xy);
	#else
		min16float4 baseColor = GetTerrainTex(terrainBaseTex, IN.baseTC.xy);	
	#endif
#endif

#if %_RT_ALPHATEST || %_RT_ALPHABLEND
	clip(baseColor.a - Get_MaterialAlphaTestShadowsWH());
#endif

#if %BILLBOARD_ATLAS
	baseColor = GetBillboardAtlasDiffuseTex(IN.baseTC.xy, 0);
#endif

#if MATERIAL_ATLAS
	int featureIndex = GetFeatureIndex(IN.featureIndex, IN.baseTC.xy);

	float3 materialAtlasTC[2];
	GetMaterialAtlasTC(materialAtlasTC, IN.baseTC.xy, featureIndex);

	#if CLS_SCRATCH
		// WH[TBa]: implicit truncation of vector type, KCD2-448804
		half3 macroMask = BloodGrimeScratchTexture.Sample(ssMaterialTrilinear, IN.baseTC.xy).rgb;
		const half materialAtlasBlendFactor = ComputeScratchIntensity(macroMask.g, featureIndex);
	#else
		const half materialAtlasBlendFactor = 0;
	#endif //CLS_SCRATCH

	ClipMaterialAtlasAlpha(materialAtlasTC, featureIndex, materialAtlasBlendFactor);
#endif //MATERIAL_ATLAS

#if (!ENABLE_TESSELLATION || %_RT_NO_TESSELLATION) && %_RT_SAMPLE4
	// output RSM color component
	#if !%TEMP_TERRAIN
		OUT.Color.rgb = baseColor.rgb * MatDifColor.rgb;
	#else
		OUT.Color.rgb = baseColor.rgb;
	#endif

	#if	%TEMP_VEGETATION
		OUT.Color.a = CP_ShadowGen_VegetationAlphaClamp.x;
	#else
		OUT.Color.a = 1.f;
	#endif

	OUT.Normal.xyz = normalize(min16float3(IN.Normal.xyz))*.5h+.5h;
	OUT.Normal.w = 1;
#endif

	// WH GM: Removed last parameter to unify dissolve across materials and prevent out-of-sync issues like #KCD2-329079
	ApplyDissolve(Get_SPI_Dissolve(), (int2)IN.WPos.xy);

	return OUT;
}

//======================================================================

technique ShadowGen
{
	pass p0
	{
		VertexShader = Common_SG_VS() ShadowGenVS;
#if ENABLE_TESSELLATION
		HullShader   = Common_ShadowGenHS() ShadowGenVS;
		DomainShader = Common_ShadowGenDS() ShadowGenVS;
#endif

		ZEnable = true;
		ZWriteEnable = true;
		CullMode = Back;

		PixelShader = Common_SG_PS() ShadowGenPS;

		// WH[TBa]: our skin assets are always one-sided and water-tight, KCD2-123979
    #if %GRASS || %LEAVES || %HAIR_PASS
      CullMode = None;
    #endif
  }
}
