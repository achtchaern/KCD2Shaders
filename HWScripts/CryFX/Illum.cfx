// Shader global descriptions
float Script : STANDARDSGLOBAL
<
	string Script =        
		"Public;"
	#if %DECAL
		"Decal;"
	#endif     
	#if %VERTCOLORS && !%SNDUVS
		"VertexColors"
	#endif
	#if %BILLBOARD
		"Billboard"
	#endif
	#if ENABLE_TESSELLATION
		"HWTessellation;"
	#endif
		"SupportsDeferredShading;"
		"SupportsFullDeferredShading;"
		"SupportsAttrInstancing;"
		"ShaderDrawType = Light;"
		"ShaderType = General;"
	#if HIDING_GROUPS
		"SupportsHidingGroupsWH"
	#endif
	#if CLS_BLOOD
		"SupportsBloodWH"
	#endif
	#if CLS_GRIME
		"SupportsGrimeWH"
	#endif
	#if CLS_SCRATCH
		"SupportsScratchWH"
	#endif
>;

