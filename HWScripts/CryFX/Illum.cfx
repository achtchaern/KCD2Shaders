Texture2D<min16float4> BlendTex : register(t11)
<
  UIName = "Blending Map";
  UIDescription = "Blending Map between the two layers";
> = TM_Opacity;

Texture2D<min16float4> smoothness2Tex : register(t7) = TM_DecalOverlay;
#endif

