#if %SNDUVS
half4 GetSNDUVSDiffuseTex(float2 texTC)
{
	return GetTexture2D(SNDUVSDiffuseTex, ssMaterialAnisoHigh, texTC);
}
#endif

// WH[TBa]: changed signature of this function multiple times
#if %SNDUVS
void GatherMaterialAttribs(in half3x3 mTangentToWS, in float2 baseTC, in float2 secondTC, in half4 vertexColor, in float worldDistance, out MaterialAttribsCommon attribs)
#else
void GatherMaterialAttribs(in min16float3x3 mTangentToWS, in float2 baseTC, in min16float4 vertexColor, in float worldDistance, out MaterialAttribsCommon attribs)
#endif
{
	// TODO: SilPom: Find way to compute lod without gradients as they cause pixel artifacts at fin / shell transition
	
	attribs = MaterialAttribsDefault();

#if %WEAPON
	WeaponParams wpnParams;
	GetWeaponParams(wpnParams, baseTC);
#endif
	
  // Base layer
	min16float3 vNormalTS = min16float3(0, 0, 1);
#if %NORMAL_MAP
	vNormalTS = GetNormalMap(normalsTex, baseTC.xy);
#endif
	attribs.Smoothness = MatSpecColor.w * GetSmoothnessTex(smoothnessTex, baseTC.xy);

	// WH[TBa]: multiply by material color later to unify with CommonZPass, KCD2-130352

	#if !%SILHOUETTE_PARALLAX_OCCLUSION_MAPPING
		attribs.Albedo = GetDiffuseTex(diffuseTex, baseTC.xy).rgb;
	#else
		attribs.Albedo = GetDiffuseTex(diffuseTex, float4(baseTC.xy, 0, 0));
	#endif

	// Decals
#if %DECAL && %_RT_DECAL_TEXGEN_2D
	#if %_TT_TEXCOORD_PROJ
		attribs.Albedo = GetDiffuseDecalTex(diffuseTex, baseTC.xy / baseTC.w).rgb;
	#else
		attribs.Albedo = GetDiffuseDecalTex(diffuseTex, baseTC.xy).rgb;
	#endif 
#endif
	
	attribs.Reflectance = MatSpecColor.rgb;
#if %SPECULAR_MAP
	#if !%SILHOUETTE_PARALLAX_OCCLUSION_MAPPING
		half3 specMap = GetSpecularTex(specularTex, baseTC.xy).rgb;
	#else
		half3 specMap = GetSpecularTexLod(specularTex, float4(baseTC.xy, 0, 0)).rgb;
	#endif

	#if %COLORIZING_WITH_MASK
		ApplyColorizingWithMask(attribs.Albedo, specMap);
	#endif

	attribs.Reflectance *= specMap;
#endif

#if %COLORIZING
	ApplyColorizing(attribs.Albedo);
#endif

	// Blend layer
	// WH[TBa]: unify blendFac between blend layer and dir overlay, KCD2-130352
	min16float blendFac = 0;
#if %BLENDLAYER
	#if %SNDUVS
		blendFac = GetLayerBlendingValue(SNDUVSDiffuseTex, secondTC.xy, 0, 1.h, BlendFactor, BlendFalloff);
	#else
		blendFac = GetLayerBlendingValue(BlendTex, baseTC.xy * BlendMaskTiling, 0, vertexColor.w, BlendFactor, BlendFalloff);
	#endif
	
	#if !%SILHOUETTE_PARALLAX_OCCLUSION_MAPPING
		min16float4 diffuseMap2 = GetDiffuse2Tex(Diffuse2Tex, baseTC.xy * BlendLayer2Tiling);
	#else
		min16float4 diffuseMap2 = GetDiffuse2TexLod(Diffuse2Tex, float4(baseTC.xy * BlendLayer2Tiling, 0, 0)); // TODO: find way to compute lod without gradients as they cause pixel artifacts at fin / shell transition
	#endif
	// WH[TomK]: implicit truncation of vector type, KCD2-448804
	attribs.Albedo = lerp(attribs.Albedo, diffuseMap2.xyz, blendFac);
	
	#if !%SILHOUETTE_PARALLAX_OCCLUSION_MAPPING
		min16float glossLayer2 = GetSmoothness2Tex(smoothness2Tex, baseTC.xy * BlendLayer2Tiling);
	#else
		min16float glossLayer2 = GetSmoothness2TexLod(smoothness2Tex, float4(baseTC.xy * BlendLayer2Tiling, 0, 0)); // TODO: find way to compute lod without gradients as they cause pixel artifacts at fin / shell transition
	#endif
	attribs.Smoothness = lerp(attribs.Smoothness, glossLayer2, blendFac);
	
	attribs.Reflectance = lerp(attribs.Reflectance, BlendLayer2Specular, blendFac);
	
	min16float3 vNormal2 = GetNormalMap(Bump2Tex, baseTC.xy * BlendLayer2Tiling);
	#if %SILHOUETTE_PARALLAX_OCCLUSION_MAPPING
		const float3 norm = vNormalTS;
		const float3 binorm = cross(float3(1, 0, 0), norm);
		const float3 tang = cross(norm, binorm);
		const float3x3 matLocal = float3x3(tang, -binorm, norm);
		vNormal2 = mul(vNormal2, matLocal);
	#endif
	vNormalTS = lerp(vNormalTS, vNormal2, blendFac);
#endif

	// WH[TBa]: unify blendFac between blend layer and dir overlay, KCD2-130352
#if %DIR_OVERLAY
	attribs.NormalWorld = normalize(mul(vNormalTS, mTangentToWS));
	blendFac = GetDirOverlayBlendFactor(attribs.NormalWorld);
#endif

#if %SNDUVS
	half4 detColor = GetSNDUVSDiffuseTex(secondTC.xy);
	attribs.Albedo.xyz = (4.0 * attribs.Albedo.xyz * detColor.xyz);
#endif

#if %DIRTLAYER
    min16float4 dirtMap = GetCustomTex(dirtTex, baseTC.xy * min16float2(DirtTiling, DirtTiling));
    min16float dirtBlendFac = DirtStrength * lerp(1.0h, dirtMap.a, DirtMapAlphaInfluence) * (1 - vertexColor.a);
    attribs.Albedo = lerp(attribs.Albedo, dirtMap * DirtTint, dirtBlendFac);
    attribs.Reflectance = lerp(attribs.Reflectance, attribs.Reflectance * DirtGlossFactor, dirtBlendFac);
#endif

	// WH[TBa]: removed ifdef to reduce number of PS combinations, KCD2-335646
	attribs.Albedo *= 2.f * vertexColor.rgb;

	// Detail mapping
#if %DETAIL_MAPPING || %DETAIL_ATLAS
	min16float3 detailScales = min16float3(DetailBumpScale, DetailDiffuseScale, DetailGlossScale);

	ApplyDetailFadeoutWH(detailScales, worldDistance);

#if %SNDUVS && !%USE_FIRST_UV_DETMAP
	const min16float2 tcDetail = secondTC.xy * CM_DetailTilingAndAlphaRef.xy;
#else
	const min16float2 tcDetail = baseTC.xy * CM_DetailTilingAndAlphaRef.xy;
#endif

#if %DETAIL_ATLAS
	min16float4 detailMap = GetDetailAtlasTex(detailTex, tcDetail, baseTC.xy) * detailScales.xxyz;
#else
	min16float4 detailMap = GetDetailTex(detailTex, tcDetail) * detailScales.xxyz;
#endif

	// WH[TBa]: add detail map for secondary layer, KCD2-130352
#if %BLENDLAYER || %DIR_OVERLAY
	min16float3 vDetail2Scales = min16float3(Detail2BumpScale, Detail2DiffuseScale, Detail2GlossScale);
	min16float4 vDetail2 = 0;

	ApplyDetailFadeoutWH(vDetail2Scales, worldDistance);

	#if %SNDUVS && !%USE_FIRST_UV_DETMAP
		const float2 tcDetail2 = secondTC.xy * CM_CustomTilingOffsetWH.xy;
	#else
		const float2 tcDetail2 = baseTC.xy * CM_CustomTilingOffsetWH.xy;
	#endif

	#if %DETAIL_ATLAS
		vDetail2 = GetDetailAtlasTex(detail2Tex, tcDetail2, baseTC.xy) * vDetail2Scales.xxyz;
	#else
		vDetail2 = GetDetailTex(detail2Tex, tcDetail2) * vDetail2Scales.xxyz;
	#endif

	detailMap = lerp(detailMap, vDetail2, blendFac);
#endif

#if %ALPHAMASK_DETAILMAP
	detailMap *= GetAlphaTex(diffuseTex, baseTC.xy);
#endif
	
	#if %WEAPON
		ApplyWeaponToDetail(detailMap, wpnParams);
	#endif

	vNormalTS.xy += detailMap.xy;
	attribs.Smoothness += attribs.Smoothness * detailMap.w;
	attribs.Albedo += attribs.Albedo * detailMap.z;
#endif

	// Compute world space normal
	attribs.NormalWorld = normalize(mTangentToWS[2] + 1e-6);
#if %NORMAL_MAP || %WRINKLE_BLENDING || %DETAIL_MAPPING
	attribs.NormalWorld = normalize(mul(vNormalTS, mTangentToWS));
#endif

#if %WEAPON
	ApplyWeaponToCommonParams(attribs.Albedo, attribs.Reflectance, attribs.Smoothness, wpnParams, baseTC);
#endif

#if %DIR_OVERLAY	
	ApplyDirOverlayToNormal(vNormalTS, blendFac, baseTC.xy);
	attribs.NormalWorld = normalize(mul(vNormalTS, mTangentToWS));

	ApplyDirOverlayToAlbedo(attribs.Albedo, blendFac, baseTC.xy);
#endif

	// WH[TBa]: unify order of operations with CommonZPass, KCD2-130352
	attribs.Albedo *= MatDifColor.rgb;
}

float GatherAlpha(float4 baseTC, min16float vertexAlpha)
{
	min16float alpha = MatDifColor.w;
#if !%SILHOUETTE_PARALLAX_OCCLUSION_MAPPING
	alpha *= GetDiffuseTex(diffuseTex, baseTC.xy).w;
#else
	alpha *= GetDiffuseTex(diffuseTex, float4(baseTC.xy, 0, 0)).w;
#endif

	// WH[TBa]: removed ifdef to reduce number of PS combinations, KCD2-335646
	alpha *= vertexAlpha;

#if %DECAL
	// WH[Woody]: we never use it
	//#if !%_TT_TEXCOORD_PROJ
	//	alpha *= GetOpacityTex(DecalOpacityTex, baseTC.zw).r;
	//#else
	//	alpha *= GetOpacityTex(DecalOpacityTex, baseTC.xy).r;
	//#endif
	#if !%DIRTLAYER
		alpha = saturate(pow(alpha * DecalAlphaMult, DecalFalloff));
	#endif
#endif

#if %_RT_DECAL_TEXGEN_2D
  alpha *= 100.0 / 99.0;
#endif

	return alpha;
}

min16float3 GetEmittanceMask(float2 baseTC)
{
	// WH[TBa]: we use TM_Emittance for secondary detail map
#if (%BLENDLAYER || %DIR_OVERLAY ) && (%DETAIL_MAPPING || %DETAIL_ATLAS)
	return min16float3(1, 1, 1);
#else
	min16float4 emittanceMap = GetEmittanceTex(emittanceTex, baseTC.xy);
    emittanceMap.rgb *= pow(max(GetLuminance(emittanceMap.rgb), min16float(1e-4)), min16float(EmittanceMapGamma - 1)) * emittanceMap.a;
	
	return emittanceMap.rgb;
#endif
}

////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////

void Callback_ShadingDirect(in ForwardShadingAttribs attribs, in ForwardLightParams light, out float3 diffuseAcc, out float3 specularAcc)
{
    float3 viewVec = normalize(-attribs.worldPos);
	float NdotL = saturate(dot(attribs.normal, light.lightVec));

#if %_RT_AREA_LIGHT
	if (light.type == LIGHT_TYPE_REGULAR_AREA || light.type == LIGHT_TYPE_REGULAR_AREAFACE)
	{
		// WH[TBa]: pass directly areaAttribs, KCD2-73606
		AreaLightLTC_GGX(attribs.normal, -normalize(attribs.areaAttribs.position), attribs.smoothness, attribs.reflectance, attribs.areaAttribs, Fwd_SpotTexArray, diffuseAcc, specularAcc);
	}
	else
#endif
	if (light.type == LIGHT_TYPE_SUN)
	{
		const float3 discLightVec = ComputeNearestLightOnSunWH(attribs.normal, viewVec, light.lightVec);
		diffuseAcc.x = DiffuseBRDF(attribs.normal, viewVec, light.lightVec, attribs.smoothness, NdotL);
		specularAcc = SpecularBRDF(attribs.normal, viewVec, discLightVec, attribs.smoothness, attribs.reflectance) * NdotL;
	}
	else
	{
		diffuseAcc.x = DiffuseBRDF(attribs.normal, viewVec, light.lightVec, attribs.smoothness, NdotL);
		specularAcc = SpecularBRDF(attribs.normal, viewVec, light.lightVec, attribs.smoothness, attribs.reflectance) * NdotL;

		diffuseAcc.x *= light.illuminanceWH.inverseSquareAttenuation;
		specularAcc *= light.illuminanceWH.inverseSquareAttenuation;
	}

	diffuseAcc = diffuseAcc.x * light.illuminanceWH.color * light.illuminanceWH.clipping;
	specularAcc = specularAcc * light.illuminanceWH.color * light.illuminanceWH.clipping;

}

#include "ForwardShading.cfi"

////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////
#if %SILHOUETTE_PARALLAX_OCCLUSION_MAPPING
pixout IlluminationPS(geom2FragGeneral IN_ext)
#else
CRY_EARLY_DEPTH
pixout IlluminationPS(vert2FragGeneral IN)
#endif
{
#if %SILHOUETTE_PARALLAX_OCCLUSION_MAPPING
	vert2FragGeneral IN = IN_ext.IN;
#endif

	pixout OUT = (pixout)0;

	min16float3 emittance = MatEmissiveColor.xyz * MatEmissiveColor.w * (1000.0 / 10000.0);
	const bool bEmissive = GetLuminance(emittance.xyz) > 0;
	if (bEmissive)
	{
		// WH[TBa]: implicit truncation of vector type, KCD2-448804
		emittance *= GetEmittanceMask(IN.baseTC.xy);
	}

	// WH[TBa]: TODO: hunting remaining forward shaders, remove after Xmas, KCD2-338533
#if !%_RT_ALPHABLEND
	if (!bEmissive)
	{
		OUT.Color = float4(1.f, 0.f, 0.5f, 1.f);
		return OUT;
	}
#endif

#if !%_RT_SECONDARY_VIEW  // Do additive glow pass just when deferred shading is on
	if (bEmissive && MatDifColor.w == 1)
	{
		OUT.Color.rgb = emittance;
		return OUT;
	}
#endif

#if %_RT_ALPHATEST
	min16float diffuseMapAlpha = GetAlphaTex(diffuseTex, IN.baseTC.xy);
	clip(diffuseMapAlpha - Get_MaterialAlphaTest());
#endif

	// Gather surface material attributes
	MaterialAttribsCommon commonAttribs;
	min16float3x3 mTangentToWS = min16float3x3(IN.vTangent.xyz, IN.vBinormal.xyz, cross(IN.vTangent.xyz, IN.vBinormal.xyz) * IN.vTangent.w);
	// WH[TBa]: removed ifdef to reduce number of PS combinations, KCD2-335646
	min16float4 vertexColor = IN.Color;

	// WH[TBa]: we use worldDistance inside GatherMaterialAttribs to fade-out certain effects, like detail mapping, KCD2-130352
	const float worldDistance = IN.WPos.w * g_PS_ProjRatio.w;

#if %SNDUVS
	GatherMaterialAttribs(mTangentToWS, IN.baseTC.xy, IN.secondTC.xy, vertexColor, worldDistance, commonAttribs);
#else
	GatherMaterialAttribs(mTangentToWS, IN.baseTC.xy, vertexColor, worldDistance, commonAttribs);
#endif

	ForwardShadingAttribs fwdAttribs;
	fwdAttribs.screenUV = IN.screenProj.xy / IN.screenProj.w;
	fwdAttribs.worldPos = IN.vView.xyz;

	float3 diffuseAcc = 0, specularAcc = 0;
#if %_RT_ALPHABLEND && !%DECAL
	const bool applySunShadows = false;	
	const bool isOpaque = false;
#else
	const bool applySunShadows = true;
	const bool isOpaque = true;
#endif

	Fwd_StandardShading(commonAttribs, fwdAttribs, diffuseAcc, specularAcc, applySunShadows, isOpaque);
	
	OUT.Color.rgb = diffuseAcc + specularAcc + emittance;
	OUT.Color.a = 1;

#if %_RT_ALPHABLEND
	OUT.Color.a = GatherAlpha(IN.baseTC.xyzw, vertexColor.w);
#endif

	// WH[TBa]: only apply fog if the shader is not opaque, as opaque forward shaders run before fog generation
#if %_RT_ALPHABLEND && !%DECAL
	const float3 worldPos = IN.vView.xyz + GetWorldViewPos();
	Fwd_ApplyFog(worldPos.xyz, IN.vView.xyz, IN.WPos, OUT.Color.rgb);
#endif

	return OUT;
}

#include "IllumTess.cfi"

//////////////////////////////// technique ////////////////

technique General
<
  string Script =
        "TechniqueZ=ZPass;"
#if !%DECAL && !%SILHOUETTE_PARALLAX_OCCLUSION_MAPPING
        "TechniqueZPrepass=ZPrePass;"
#endif
        "TechniqueMotionBlur=MotionBlurPass;"
        "TechniqueCustomRender=CustomRenderPass;"
        "TechniqueEffectLayer=EffectLayerPass;"
        "TechniqueShadowGen=ShadowGen;"
        "TechniqueDebug=DebugPass;"
>
{
	pass p0
	{    
		VertexShader = IlluminationVS() GeneralVS;
#if ENABLE_TESSELLATION
		HullShader   = IllumHS() GeneralHS;
		DomainShader = IllumDS() GeneralDS;
#endif

#if %SILHOUETTE_PARALLAX_OCCLUSION_MAPPING 
		GeometryShader = IlluminationGS() GeneralGS;
#endif

		PixelShader = IlluminationPS() GeneralPS;

#if %DECAL
		ZEnable = true;    
		ZWriteEnable = false;    
		ZFunc = LEqual;
		CullMode = Back;        
#else
		ZEnable = true;    
		ZWriteEnable = true;    
		CullMode = Back;
#endif        
	}
}

