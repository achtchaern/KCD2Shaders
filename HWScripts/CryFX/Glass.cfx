RWTexture2D<float2> velocityObjTex : register(u2);
RWTexture2D<uint> depthObjTex : register(u3);

ENVIRONMENTCUBEMAP

sampler2D envMapSamplerRefr
{
	Texture = $SceneTarget;
	MinFilter = POINT;
	MagFilter = POINT;
	MipFilter = POINT;  
	AddressU = Clamp;
	AddressV = Clamp;   
	sRGBLookup = true; 
};

// WH GM: tintTex is used even when PBR is disabled
Texture2D tintTex : register(t2)
<
	UIName = "Tint Map";
	sRGBLookup = true;
> = TM_Specular;
#if !%PBR
Texture2D tintColorTex : register(t9)
<
	UIName = "Tint Colour Map";
	sRGBLookup = true;
> = TM_Custom;
#else
Texture2D thicknessMap : register(t9)
<
	UIName = "Thickness Map";
	UIDescription = "Thickness Map to control thickness per pixel";
	sRGBLookup = true;
> = TM_Custom;
#endif

