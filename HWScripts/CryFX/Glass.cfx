// Shader global descriptions
float Script : STANDARDSGLOBAL
<
	string Script =
		"Public;"
		"NoPreview;"        
		"SupportsAttrInstancing;"   
		"ShaderDrawType = Light;"  
		"VertexColors;"
		"AlphaBlendShadows;"
#if %DEPTH_FIXUP_REPLACE
	"DepthFixupReplace;"
#endif		
#if %DEPTH_FIXUP
	"DepthFixup;"
#endif
#if %DEPTH_FOG
		"ForceRefractionUpdate;"
#else
		"Refractive;"
#endif
		"ShaderType = Glass;"
#if HIDING_GROUPS
		"SupportsHidingGroupsWH;"
#endif
>;

