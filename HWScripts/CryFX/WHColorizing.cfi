// per-material constants
#if %COLORIZING || %COLORIZING_WITH_MASK
float ColorizingHue
<
	register = REG_PM_PARAM_9.x;
	string UIHelp = "Hue shift";
	string UIName = "Zone0 Colorizing Hue";
	string UIWidget = "slider"; //?
	float UIMin = -180.0;
	float UIMax = 180.0;
	float UIStep = 10.0;
> = 0.0;

float ColorizingSaturation
<
	register = REG_PM_PARAM_9.y;
	string UIHelp = "Saturation multiplier";
	string UIName = "Zone0 Colorizing Saturation";
	string UIWidget = "slider"; //?
	float UIMin = 0.0;
	float UIMax = 10.0;
	float UIStep = 1.0;
> = 1.0;

float ColorizingBrightness
<
	register = REG_PM_PARAM_9.z;
	string UIHelp = "Brightness multiplier";
	string UIName = "Zone0 Colorizing Brightness";
	string UIWidget = "slider"; //?
	float UIMin = 0.0;
	float UIMax = 10.0;
	float UIStep = 1.0;
> = 1.0;
#endif

