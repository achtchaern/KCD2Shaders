//=========================================================================
#if %COLORIZING 
void ApplyColorizing(inout half3 albedo)
{
	albedo = TransformHSV(albedo, ColorizingHue, ColorizingSaturation, ColorizingBrightness);
}
#endif

//=========================================================================
#if %COLORIZING_WITH_MASK
void ApplyColorizingWithMask(inout half3 albedo, inout half3 specMap)
{
	half fRegionMask = specMap.g; //store region mask (G channel)
	specMap = specMap.rrr; //G channel used for region mask!

	half4 vRegionHues = half4(ColorizingHue, MaskHue1, MaskHue2, MaskHue3);
	half4 vRegionBrightness = half4(ColorizingBrightness, MaskBrightness1, MaskBrightness2, MaskBrightness3);
	half4 vRegionSaturation = half4(ColorizingSaturation, MaskSaturation1, MaskSaturation2, MaskSaturation3);
	
	int regionIndex = floor(fRegionMask * 3.9999);
	albedo.xyz = TransformHSV(albedo.xyz, vRegionHues[regionIndex], vRegionSaturation[regionIndex], vRegionBrightness[regionIndex]);
}
#endif
