	string UIWidget = "slider"; //?
	float UIMin = 0.0;
	float UIMax = 10.0;
	float UIStep = 1.0;
> = 1.0;

float MaskBrightness2
<
	register = REG_PM_PARAM_10.w;
	string UIHelp = "Brightness shift region 2 (0.5..0.8)";
