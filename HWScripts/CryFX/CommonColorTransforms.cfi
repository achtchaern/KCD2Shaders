#define HALF_MAX 65504.f

// The lowest value in the ACEScc transfer function, representing 0 in a linear color space
#define ACESCC_MIN (-0.35828683f)

// The largest value in the ACEScc transfer function, representing the horizontal asymptote 
// where values trend to infinity
#define ACESCC_MAX ( 1.4679964f )

// Our content is authored and graded to DX12 spec where a floating point value of 1.0f
// is equivalent to 80 nits. When this normalization factor is used, we're reducing a range
// of values from 10,000 nits to a 0-1 range. With 80 nits being equivalent to 1.0f, 10,000
// nits are equivalent to 125.0f. That's where this number is from. 125.0f = (10,000 / 80)
#define HDR_NORMALIZATION_FACTOR 125.0f

// D3D12's `paper white` is 80nits. Converting between our linear color space where 1.0f = 80 nits
// requires constants to be multiplied or divided by this constant. 
#define HDR_WHITE_VALUE 80.0f

// WH[DH]: HDR parameters
#define MID_GRAY 0.18f

////////////////// Constants /////////////////////

