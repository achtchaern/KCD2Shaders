min16float3 GetNormalMapGrad(Texture2D<min16float4> bumpTex, float2 bumpTC, float2 ddx_bumpTC, float2 ddy_bumpTC)
{
  min16float3 bumpNormal;

  bumpNormal.xy = GetXYNormalMapGrad(bumpTex, bumpTC, ddx_bumpTC, ddy_bumpTC);
  bumpNormal.z = sqrt(saturate(1.h + dot(bumpNormal.xy, -bumpNormal.xy)));

  return bumpNormal;
}
