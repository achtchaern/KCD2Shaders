float  GetAlphaTex(Texture2D<float4> tex, float2 texTC)                                                      { return GetTexture2D(tex, ssMaterialAnisoHigh, texTC.xy).a; }// alpha test value in alpha channel
float4 GetDiffuseTex(Texture2D<float4> tex, float2 texTC)                                                    { return GetTexture2D(tex, ssMaterialAnisoHigh, texTC.xy); }
float4 GetDiffuseTexGrad(Texture2D<float4> tex, float2 texTC, float2 ddxUV, float2 ddyUV)                    { return GetTexture2DGrad(tex, ssMaterialAnisoHigh, texTC.xy, ddxUV, ddyUV ); }
float4 GetDiffuseTexLod(Texture2D<float4> tex, float4 texTC)                                                 { return GetTexture2DLod(tex, ssMaterialAnisoHigh, texTC.xyzw); }
float4 GetDiffuseTexProj(Texture2D<float4> tex, float4 texTC)                                                { return GetTexture2DProj(tex, ssMaterialAnisoHigh, texTC.xyzw); }
float4 GetDiffuseTexBias(Texture2D<float4> tex, float4 texTC)                                                { return GetTexture2DBias(tex, ssMaterialAnisoHigh, texTC.xyzw); }
float4 GetDiffuseTexBilinear(Texture2D<float4> tex, float2 texTC)                                            { return GetTexture2D(tex, ssMaterialBilinear, texTC.xy); }
float4 GetCustomTex(Texture2D<float4> tex, float2 texTC)                                                     { return GetTexture2D(tex, ssMaterialAnisoHigh, texTC.xy); }
float4 GetCustomTexLod(Texture2D<float4> tex, float4 texTC)                                                  { return GetTexture2DLod(tex, ssMaterialAnisoHigh, texTC.xyzw); }
float4 GetDiffuse2Tex(Texture2D<float4> tex, float2 texTC)                                                   { return GetCustomTex(tex, texTC.xy); }
float4 GetDiffuse2TexLod(Texture2D<float4> tex, float4 texTC)                                                { return GetCustomTexLod(tex, texTC.xyzw); }
float4 GetDiffuseDecalTex(Texture2D<float4> tex, float2 texTC)                                               { return GetTexture2D(tex, ssMaterialAnisoHighBorder, texTC.xy); }
float  GetHeightTex(Texture2D<float4> tex, float2 texTC)                                                     { return GetTexture2D(tex, ssMaterialTrilinear, texTC.xy).r; }
float  GetHeightTexLod(Texture2D<float4> tex, float4 texTC)                                                  { return GetTexture2DLod(tex, ssMaterialTrilinear, texTC.xyzw).r; }
float4 GetHeight2Tex(Texture2D<float4> tex, float2 texTC)                                                    { return GetTexture2D(tex, ssMaterialTrilinear, texTC.xy); }
float4 GetHeight2TexLod(Texture2D<float4> tex, float4 texTC)                                                 { return GetTexture2DLod(tex, ssMaterialTrilinear, texTC.xyzw); }
float4 GetSpecularTex(Texture2D<float4> tex, float2 texTC)                                                   { return GetTexture2D(tex, ssMaterialAnisoHigh, texTC.xy); }
float4 GetSpecularTexLod(Texture2D<float4> tex, float4 texTC)                                                { return GetTexture2DLod(tex, ssMaterialAnisoHigh, texTC.xyzw); }
float  GetSmoothnessTex(Texture2D<float4> tex, float2 texTC)                                                 { return GetTexture2D(tex, ssMaterialTrilinear, texTC.xy).r; }
float  GetSmoothness2Tex(Texture2D<float4> tex, float2 texTC)                                                { return GetTexture2D(tex, ssMaterialTrilinear, texTC.xy).r; }
float  GetSmoothness2TexLod(Texture2D<float4> tex, float4 texTC)                                             { return GetTexture2DLod(tex, ssMaterialTrilinear, texTC.xyzw).r; }
float4 GetDetailTex(Texture2D<float4> tex, float2 texTC)                                                     { return GetTexture2D(tex, ssMaterialTrilinear, texTC.xy).garb * 2 - 1; }
float4 GetDetailTexLod(Texture2D<float4> tex, float4 texTC)                                                  { return GetTexture2DLod(tex, ssMaterialTrilinear, texTC.xyzw).garb * 2 - 1; }
float  GetOpacityTex(Texture2D<float4> tex, float2 texTC)                                                    { return GetTexture2D(tex,  ssMaterialTrilinear, texTC.xy).r; }
float  GetOpacityTexLod(Texture2D<float4> tex, float4 texTC)                                                 { return GetTexture2DLod(tex,  ssMaterialTrilinear, texTC.xyzw).r; }
float4 GetBlendTex(Texture2D<float4> tex, float2 texTC)                                                      { return GetOpacityTex(tex, texTC.xy).r; }
float4 GetBlendTexLod(Texture2D<float4> tex, float4 texTC)                                                   { return GetOpacityTexLod(tex, texTC.xyzw).r; }
float4 GetDecalTex(Texture2D<float4> tex, float2 texTC)                                                      { return GetTexture2D(tex, ssMaterialTrilinearBorder, texTC.xy); }
float4 GetCustomSecTex(Texture2D<float4> tex, float2 texTC)                                                  { return GetTexture2D(tex, ssMaterialAnisoHigh, texTC.xy); }
float4 GetEmittanceTex(Texture2D<float4> tex, float2 texTC)                                                  { return GetTexture2D(tex, ssMaterialAnisoHigh, texTC.xy); }
float4 GetEnvCubeTex(TextureCube<float4> tex, float3 texTC)                                                  { return GetTextureCube(tex, ssMaterialTrilinearClamp, texTC.xyz); }
float4 GetEnvCubeTexLod(TextureCube<float4> tex, float4 texTC)                                               { return GetTextureCubeLod(tex, ssMaterialTrilinearClamp, texTC.xyzw); }
float4 GetSceneTex(Texture2D<float4> tex, float2 texTC)                                                      { return GetTexture2D(tex, ssPointClamp, texTC.xy); }       // TODO: convert to load
float4 GetSceneTexProj(Texture2D<float4> tex, float4 texTC)                                                  { return GetTexture2DProj(tex, ssPointClamp, texTC.xyzw); } // TODO: convert to load
float4 GetDissolveTex(Texture2D<float4> tex, float2 texTC)                                                   { return GetTexture2D(tex, ssPointWrap, texTC.xy); }
float4 GetDissolveTexLod(Texture2D<float4> tex, float4 texTC)                                                { return GetTexture2DLod(tex, ssPointWrap, texTC.xyzw); }
float4 GetPerlinNoiseTexLod(Texture2D<float4> tex, float4 texTC)                                             { return GetTexture2DLod(tex, ssMaterialTrilinear, texTC.xyzw); }
float4 GetTerrainTex(Texture2D<float4> tex, float2 terrainTC)                                                { return GetTexture2D(tex, ssMaterialBilinearClamp, terrainTC) * g_PS_TerrainInfo.x; }
float3 GetTerrainNormal(Texture2D<float4> tex, float2 terrainTC) 
{ 
	float3 terrainNor = GetTexture2D(tex, ssMaterialBilinearClamp, terrainTC).xzy; 
	terrainNor.xy = (terrainNor.xy - 0.5h) * 2.h; 
	terrainNor.z = sqrt(saturate(1.02h - (terrainNor.x * terrainNor.x + terrainNor.y * terrainNor.y))); 
	return terrainNor; 
}
float GetTerrainElevation(Texture2D<float4> tex, float2 terrainTC)
{
	float4 terrainElev = GetTexture2D(tex, ssMaterialBilinearClamp, terrainTC);
	return terrainElev.x;
}

