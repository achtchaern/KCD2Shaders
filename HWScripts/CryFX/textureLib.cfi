{
  min16float3 bumpNormal;

  bumpNormal.xy = GetXYNormalMap(bumpTex, bumpTC.xy);
  bumpNormal.z = sqrt(saturate(1.h + dot(bumpNormal.xy, -bumpNormal.xy)));

  return bumpNormal;
}

min16float3 GetNormalMap(Texture2D<min16float4> bumpTex, SamplerState samplerState, float2 bumpTC)
{
  min16float3 bumpNormal;

  bumpNormal.xy = GetXYNormalMap(bumpTex, samplerState, bumpTC.xy);
  bumpNormal.z = sqrt(saturate(1.h + dot(bumpNormal.xy, -bumpNormal.xy)));

  return bumpNormal;
}

min16float3 GetNormalMapLod(Texture2D<min16float4> bumpTex, SamplerState samplerState, float4 bumpTC)
{
  min16float3 bumpNormal;

  bumpNormal.xy = GetXYNormalMapLod(bumpTex, samplerState, bumpTC);
  bumpNormal.z = sqrt(saturate(1.h + dot(bumpNormal.xy, -bumpNormal.xy)));

  return bumpNormal;
