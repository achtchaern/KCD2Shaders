////////////////////////////////////////////////////////////////////////////////////////////////////
float2 GetXYNormalMap(Texture2D<float4> bumpTex, float2 bumpTC)                                           { return GetTexture2D(bumpTex, ssMaterialAnisoHigh, bumpTC).yx; }
float2 GetXYNormalMap(Texture2D<float4> bumpTex, SamplerState samplerState, float2 bumpTC)                { return GetTexture2D(bumpTex, samplerState, bumpTC).yx; }
float2 GetXYNormalMapLod(Texture2D<float4> bumpTex, SamplerState samplerState, float4 bumpTC)             { return GetTexture2DLod(bumpTex, samplerState, bumpTC).yx; }
float2 GetXYNormalMapGrad(Texture2D<float4> bumpTex, float2 bumpTC, float2 ddx_bumpTC, float2 ddy_bumpTC) { return GetTexture2DGrad(bumpTex, ssMaterialAnisoHigh, bumpTC, ddx_bumpTC, ddy_bumpTC).yx; }

float3 GetNormalMap(Texture2D<float4> bumpTex, float2 bumpTC)
{
  float3 bumpNormal;

  bumpNormal.xy = GetXYNormalMap(bumpTex, bumpTC.xy);
  bumpNormal.z = sqrt(saturate(1.h + dot(bumpNormal.xy, -bumpNormal.xy)));

  return bumpNormal;
}

float3 GetNormalMap(Texture2D<float4> bumpTex, SamplerState samplerState, float2 bumpTC)
{
  float3 bumpNormal;

  bumpNormal.xy = GetXYNormalMap(bumpTex, samplerState, bumpTC.xy);
  bumpNormal.z = sqrt(saturate(1.h + dot(bumpNormal.xy, -bumpNormal.xy)));

  return bumpNormal;
}

float3 GetNormalMapLod(Texture2D<float4> bumpTex, SamplerState samplerState, float4 bumpTC)
{
  float3 bumpNormal;

  bumpNormal.xy = GetXYNormalMapLod(bumpTex, samplerState, bumpTC);
  bumpNormal.z = sqrt(saturate(1.h + dot(bumpNormal.xy, -bumpNormal.xy)));

  return bumpNormal;
}

float3 GetNormalMapGrad(Texture2D<float4> bumpTex, float2 bumpTC, float2 ddx_bumpTC, float2 ddy_bumpTC)
{
  float3 bumpNormal;

  bumpNormal.xy = GetXYNormalMapGrad(bumpTex, bumpTC, ddx_bumpTC, ddy_bumpTC);
  bumpNormal.z = sqrt(saturate(1.h + dot(bumpNormal.xy, -bumpNormal.xy)));

  return bumpNormal;
}

#if FEATURE_RELAXED_PRECISION
min16float2 GetXYNormalMap(Texture2D<min16float4> bumpTex, float2 bumpTC)                                           { return GetTexture2D(bumpTex, ssMaterialAnisoHigh, bumpTC).yx; }
min16float2 GetXYNormalMap(Texture2D<min16float4> bumpTex, SamplerState samplerState, float2 bumpTC)                { return GetTexture2D(bumpTex, samplerState, bumpTC).yx; }
min16float2 GetXYNormalMapLod(Texture2D<min16float4> bumpTex, SamplerState samplerState, float4 bumpTC)             { return GetTexture2DLod(bumpTex, samplerState, bumpTC).yx; }
min16float2 GetXYNormalMapGrad(Texture2D<min16float4> bumpTex, float2 bumpTC, float2 ddx_bumpTC, float2 ddy_bumpTC) { return GetTexture2DGrad(bumpTex, ssMaterialAnisoHigh, bumpTC, ddx_bumpTC, ddy_bumpTC).yx; }

