////////////////////////////////////////////////////////////////////////////////////////////////////
float4 GetTexture2DGrad(Texture2D<float4> tex, SamplerState samplerState, float2 uv, float2 ddxUV, float2 ddyUV) { return tex.SampleGrad(samplerState, uv.xy, ddxUV, ddyUV ); }
float4 GetTexture2DLod(Texture2D<float4> tex, SamplerState samplerState, float4 uv)                              { return tex.SampleLevel(samplerState, uv.xy, uv.w); }
float2 GetTexture2DLod(Texture2D<float2> tex, SamplerState samplerState, float4 uv)                              { return tex.SampleLevel(samplerState, uv.xy, uv.w); }
float4 GetTexture2DLod(Texture2D<float4> tex, SamplerState samplerState, float2 uv, float Lod)                   { return tex.SampleLevel(samplerState, uv.xy, Lod); }
float4 GetTexture2DProj(Texture2D<float4> tex, SamplerState samplerState, float4 uv)                             { return tex.Sample(samplerState, uv.xy * rcp(uv.w)); }
float2 GetTexture2DProj(Texture2D<float2> tex, SamplerState samplerState, float4 uv)                             { return tex.Sample(samplerState, uv.xy * rcp(uv.w)); }
float4 GetTexture2DBias(Texture2D<float4> tex, SamplerState samplerState, float4 uv)                             { return tex.SampleBias(samplerState, uv.xy, uv.w); }
float4 GetTexture2D(Texture2D<float4> tex, SamplerState samplerState, float2 uv)                                 { return tex.Sample(samplerState, uv); }
float4 GetTextureCube(TextureCube<float4> tex, SamplerState samplerState, float3 uv)                             { return tex.Sample(samplerState, uv); }
float4 GetTextureCubeLod(TextureCube<float4> tex, SamplerState samplerState, float4 uv)                          { return tex.SampleLevel(samplerState, uv.xyz, uv.w); }

#if FEATURE_RELAXED_PRECISION
min16float4 GetTexture2DGrad(Texture2D<min16float4> tex, SamplerState samplerState, float2 uv, float2 ddxUV, float2 ddyUV) { return tex.SampleGrad(samplerState, uv.xy, ddxUV, ddyUV ); }
min16float4 GetTexture2DLod(Texture2D<min16float4> tex, SamplerState samplerState, float4 uv)                              { return tex.SampleLevel(samplerState, uv.xy, uv.w); }
min16float2 GetTexture2DLod(Texture2D<min16float2> tex, SamplerState samplerState, float4 uv)                              { return tex.SampleLevel(samplerState, uv.xy, uv.w); }
min16float4 GetTexture2DLod(Texture2D<min16float4> tex, SamplerState samplerState, float2 uv, float Lod)                   { return tex.SampleLevel(samplerState, uv.xy, Lod); }
min16float4 GetTexture2DProj(Texture2D<min16float4> tex, SamplerState samplerState, float4 uv)                             { return tex.Sample(samplerState, uv.xy * rcp(uv.w)); }
min16float2 GetTexture2DProj(Texture2D<min16float2> tex, SamplerState samplerState, float4 uv)                             { return tex.Sample(samplerState, uv.xy * rcp(uv.w)); }
min16float4 GetTexture2DBias(Texture2D<min16float4> tex, SamplerState samplerState, float4 uv)                             { return tex.SampleBias(samplerState, uv.xy, uv.w); }
min16float4 GetTexture2D(Texture2D<min16float4> tex, SamplerState samplerState, float2 uv)                                 { return tex.Sample(samplerState, uv); }
min16float4 GetTextureCube(TextureCube<min16float4> tex, SamplerState samplerState, float3 uv)                             { return tex.Sample(samplerState, uv); }
