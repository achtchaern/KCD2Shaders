#include "Common.cfi"
#include "ShadeLib.cfi"
#include "vertexLib.cfi"

float Script : STANDARDSGLOBAL
<
  string Script =        
				"Public;"
				"ShaderType = General;"
				"ShaderDrawType = General;"
				"AfterHDRPostProcess;"
				"ForceDrawLast;"
>;

vert2FragGeneral ReferenceImageVS(app2vertGeneral IN)
{
  vert2FragGeneral OUT = (vert2FragGeneral) 0;

	streamPos vertPassPos = (streamPos)0;
  vs_shared_output(IN, OUT, vertPassPos, false);
  
  return OUT;
}

float4 ReferenceImagePS(in vert2FragGeneral IN) : SV_Target0
{ 
  // WH GM: implicit truncation of vector type, KCD2-448804
  float4 cColor = GetDiffuseTex(diffuseTex, IN.baseTC.xy);

	cColor.xyz = LinearToSRGB(cColor.xyz);
  cColor.w *= MatDifColor.w;

	return cColor;
}

technique General
{
  pass p0
  {     
    VertexShader = ReferenceImageVS();
    PixelShader = ReferenceImagePS();
  }
}

