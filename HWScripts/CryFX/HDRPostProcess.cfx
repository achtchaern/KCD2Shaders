/// Un-Tweakables //////////////////////
float4 ScreenSize  : PB_ScreenSize < register = VS_REG_PB_0 >;

float4 SampleOffsets[16] < register = c0; >
float4x4 mViewProjPrev;

float4 HDRParams0;

float4 HDREyeAdaptation;
float4 HDRFilmCurve;
float3 HDRBloomColor;
float4 HDRColorBalance;			// (ColorBalance.rgb, fHDRSaturation)
float4 HDRMiscParams;			// (1.0f, 1.0f, 1.0f, 1.0f)
float4 HDRUserModification;		// Pow, Mul, Add
float4 HDRWhiteBalance;			// WH[Owlcat/Kazakov]: White balance control. RGB - LMS color space channel multipliers, A - unused

float4 SunShafts_SunCol;

float4 ElapsedTime;
float Time = {PB_time};

Texture2D<float4> zMap : register(t0);

Texture2DMS<float4> baseMapMS : register(t0);
Texture2DMS<float4> zMapMS : register(t0);

struct app2vertToneMap
{
	IN_P
	IN_TBASE

#if %_RT_MULTIVIEW && FEATURE_VR_MULTIVIEW
	uint ViewID         : SV_ViewID;
#endif
};

struct app2vertFog
{
	IN_P
	float2 baseTC       : TEXCOORD0;
};

struct vert2frag
{
	OUT_HPOS_IN_WPOS

	float4 baseTC       : TEXCOORD0;
	float4 baseTCScaled : TEXCOORD1;
};

struct vert2fragFog
{
	OUT_HPOS_IN_WPOS

	float2 baseTC       : TEXCOORD0;

	MSAA_SAMPLE_INDEX_PS
};

/////////////////////////////////////////////////////////////////////////////////////

vert2frag TransformedVS(app2vertToneMap IN)
{
	vert2frag OUT = (vert2frag)0; 
	float4 vPos = IN.Position;

	vPos.y = 1 -vPos.y;
	OUT.HPosition = float4(vPos.xy*2-1, vPos.z, 1.0);

	float2 baseTC = IN.baseTC.xy;

	min16float2 offset = min16float2(frac(Time.x*27), frac(Time.x*19));

	OUT.baseTC.xy = baseTC;

	OUT.baseTCScaled.xy = GetScaledScreenTC(baseTC);    
	OUT.baseTCScaled.wz = ((OUT.baseTCScaled.xy + offset) / 64.0) * g_VS_ScreenSize.xy;

	return OUT;
}

vert2fragFog PreTransformedFogVS(app2vertFog IN)
{
	vert2fragFog OUT = (vert2fragFog)0;

	OUT.HPosition = Get2dHPos(IN.Position);
	OUT.baseTC.xy = IN.baseTC.xy;

	return OUT;
}

////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////

Texture2D<float4> HDRBloom_Temp           : register(t0); // WxH quarter res
Texture2D<float4> HDRBloom_Temp2          : register(t1); // WxH quarter res
SamplerState HDRCalc_BloomSampler         : register(s0); // PointClamp or LinearClamp

float4 HDRBloomGaussianPS(vtxOut IN) : SV_Target
{
	const float weights[15] = { 153, 816, 3060, 8568, 18564, 31824, 43758, 48620, 43758, 31824, 18564, 8568, 3060, 816, 153 };
	const float weightSum = 262106.0;
	
	float2 coords = IN.baseTC.xy - HDRParams0.xy * 7.0;
	min16float3 vColor = 0;
	
	[unroll]
	for (int i = 0; i < 15; ++i)
	{
		vColor += GetTexture2D(HDRBloom_Temp, HDRCalc_BloomSampler, coords).rgb * (weights[i] / weightSum);
		coords += HDRParams0.xy;
	}
	
	// Compose sum of Gaussians in final pass
#if %_RT_SAMPLE0
	min16float3 bloom0 = GetTexture2D(HDRBloom_Temp2, HDRCalc_BloomSampler, IN.baseTC.xy).rgb;
	min16float3 bloom1 = vColor;

	vColor = (0.0174 * bloom0 + 0.192 * bloom1) / (0.0174 + 0.192);
#endif
	
	return float4(vColor, 0.0f);
}

////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////

float4 SampleLumOffsets0;
float4 SampleLumOffsets1;

Texture2D<float4> HDRLum_Targ           : register(t0);
Texture2D<float4> HDRLum_Norm           : register(t1);
Texture2D<float4> HDRLum_Diff           : register(t2);
Texture2D<float4> HDRLum_Spec           : register(t3);
SamplerState HDRLum_LClampSampler       : register(s0);   //LinearClamp

float2 HDRSampleLumInitialPS(vtxOut IN) : SV_Target
{
	min16float  fCenterWeight = 1;//saturate(1-length(IN.baseTC.xy*2-1));
	min16float2 vLumInfo = 0;

#if !%_RT_SAMPLE0	
	min16float  fRecipSampleCount = 0.25h;
	float2 sampleOffsets[4] = {SampleLumOffsets0.xy, SampleLumOffsets0.zw, SampleLumOffsets1.xy, SampleLumOffsets1.zw};
	[unroll] for (int i = 0; i < 4; ++i)
#else
	min16float  fRecipSampleCount = 1;
	float2 sampleOffsets[1] = { float2(0, 0) };
	int i = 0;
#endif
	{
		float2 SampleTC = IN.baseTC.xy + sampleOffsets[i];

		// --- SAMPLE ONLY LOWER 70% OF SCREEN ---
		// compress Y into [0.30 .. 1.00]
		SampleTC.y = 0.30h + SampleTC.y * 0.70h;

		SampleTC = MapViewportToRaster(SampleTC);

#if  %_RT_SAMPLE1   // Using GBuffer
	#if !%_RT_SAMPLE0		 
		MaterialAttribsCommon attribs = DecodeGBuffer(
			GetTexture2D(HDRLum_Norm, HDRLum_LClampSampler, SampleTC),
			GetTexture2D(HDRLum_Diff, HDRLum_LClampSampler, SampleTC),
			GetTexture2D(HDRLum_Spec, HDRLum_LClampSampler, SampleTC));
	#else
		MaterialAttribsCommon attribs = DecodeMicroGBuffer(
			HDRLum_Norm, IN.WPos.xy, int2(SampleTC * CV_ScreenSize.xy)
		);
	#endif

		min16float baseColorLum = max(max(GetLuminance(attribs.Albedo), GetLuminance(attribs.Reflectance)), 0.01);
		
		// Assume emissive surfaces (especially sky) have the typical scene reflectance to keep auto exposure more stable
		if (GetLuminance(attribs.Albedo) == 0)
			baseColorLum = 0.2;
#endif
		
		min16float3 cTex = GetTexture2D(HDRLum_Targ, HDRLum_LClampSampler, SampleTC).rgb;
		min16float  fLum = all(isfinite(cTex)) ? GetLuminance(cTex) : 0;  // Filter out nans
		// WH[MMatous]: KCD2 is apparently much darker than Hunt. So we need more zeroes
		fLum = max(1e-6, fLum);

		vLumInfo.x += log(fLum);                      // Luminance
#if  %_RT_SAMPLE1   // Using GBuffer
		vLumInfo.y += log(fLum / baseColorLum * PI);  // Illuminance
#endif
	}

	return fCenterWeight * fRecipSampleCount * vLumInfo;
}


///////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////

float2 HDRSampleLumIterativePS(vtxOut IN) : SV_Target
{
	const int nIter = 4;
	const min16float nIterI = 0.25f;

	// TODO: Could use Gather instead? (no iteration necessary)
	min16float2 vResampleSum = 0; 
	for (int i=0; i < nIter; i++)
		vResampleSum += GetTexture2D(HDRLum_Targ, HDRLum_LClampSampler, IN.baseTC.xy + SampleOffsets[i].xy).rg;

	vResampleSum *= nIterI;
#if %_RT_SAMPLE0 
	vResampleSum = exp( vResampleSum );
#endif

	return vResampleSum;
}

////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////
// Final eye/luminance adaptation

Texture2D<float2> HDRCalc_Prev : register(t0); // 1x1 rg
Texture2D<float2> HDRCalc_TMap : register(t1); // 1x1 rg

float2 HDRCalculateAdaptedLumPS() : SV_Target
{
	min16float2 vAdaptedLum = HDRCalc_Prev.Load(int3(0, 0, 0));
	min16float2 vCurrentLum = HDRCalc_TMap.Load(int3(0, 0, 0));

	return max(0, vAdaptedLum + (vCurrentLum - vAdaptedLum) *  ElapsedTime.yz);
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////

min16float4 GetHDRTargetMS( float2 baseTC, int NumSamples, int nCurrSample ) 
{
	int3 vPixCoord = int3( baseTC * PS_ScreenSize.xy, 0);
	return baseMapMS.Load(vPixCoord, nCurrSample);
}

min16float4 GetZTargetMS( float2 baseTC, int NumSamples, int nCurrSample ) 
{
	// WH[TBa]: implicit truncation of vector type, KCD2-448804
	int2 vPixCoord = int2( baseTC * PS_ScreenSize.xy );
	return zMapMS.Load(vPixCoord, nCurrSample);
}

////////////////////////////////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////////////////////////////////

Texture2D<float3> hdrTex   : register(t0); // WxH
Texture2D luminanceTex     : register(t1); // 1x1

Texture2D<float3> bloomTex : register(t2); // WxH quarter res
Texture2D vignettingTex    : register(t7); // ?x?
Texture2D<min16float4> colorChartTex : register(t8); // ?x?
Texture2D sunShaftsTex     : register(t9); // WxH full or min16float res

SamplerState linearClampSS : register(s0);

// WH[DH]: Match the mid gray value shifted by Hable tonemapper
static const min16float MID_GRAY_CORRECTION = MID_GRAY / GetLuminance(Inverse_ToneMap_FilmMapping(MID_GRAY));

// WH[DH]: HDR Tonemapping parameters
float4 HDRDisplayParams;
float4 HDRTonemappingParams;

#define HDRDisplayBrightness       HDRDisplayParams.x
#define HDRTonemappingContrast     HDRTonemappingParams.x
#define HDRTonemappingLinearStart  HDRTonemappingParams.y
#define HDRTonemappingLinearLength HDRTonemappingParams.z
#define HDRTonemappingShadow       HDRTonemappingParams.w

// WH[Owlcat/Kazakov]: Moved from PostAA::FinalComposition
Texture3D<float4> PostAA_Grain            : register(t6);
SamplerState PostAA_GrainSS               : register(s2);   //WH[Owlcat/Kazakov]: changed to BilinearWrap to support grain scale

// WH[Owlcat/Kazakov]: Moved from PostAA::FinalComposition
// WH[Owlcat/Kazakov]: Added scale as y component
float4 GrainParams; // x - amount, y - scale, zw - unused

// WH[Owlcat/Kazakov]: Moved from PostAA::FinalComposition
// Grain technique was moved out of HDR post process, since TAA filters pixel sized noise out
void ApplyFilmGrain(inout min16float3 cScene, in min16float3 cColor, float2 WPos, float2 baseTC)
{
	// Film grain simulation
	// WH[TBa]: implicit truncation of vector type, KCD2-448804
	// WH[Owlcat/Kazakov]: Added scale
	min16float fFilmGrain = PostAA_Grain.Sample(PostAA_GrainSS, float3(baseTC.xy * GrainParams.y * float2(PS_ScreenSize.x / PS_ScreenSize.y, 1.0f), Time * 3)).x;
	fFilmGrain = lerp(0.5h, fFilmGrain, GrainParams.x);

	// Overlay blending
	cScene.xyz = step(0.5h, cColor.xyz);
	cScene.xyz = lerp((cColor.xyz * fFilmGrain * 2.h), (1.h - (2.h * (1.h - cColor.xyz) * (1.h - fFilmGrain))), cScene.xyz);
}

// WH[Owlcat/Kazakov]: Added for photomode
void ApplyWhiteBalance(inout min16float3 cColor)
{
	// Linear <-> LMS color space conversion
    const min16float3x3 LinToLMS = min16float3x3(
        3.90405e-1f, 5.49941e-1f, 8.92632e-3f,
        7.08416e-2f, 9.63172e-1f, 1.35775e-3f,
        2.31082e-2f, 1.28021e-1f, 9.36245e-1f
    );
    const min16float3x3 LMSToLin = min16float3x3(
        2.85847e+0, -1.62879e+0, -2.48910e-2,
        -2.10182e-1,  1.15820e+0,  3.24281e-4,
        -4.18120e-2, -1.18169e-1,  1.06867e+0
	);

	cColor = mul(LinToLMS, cColor);
	cColor *= HDRWhiteBalance.rgb;
	cColor = mul(LMSToLin, cColor);
}

// WH[DH]: HDR pipeline
min16float3 HDRComposition(in min16float3 cScene, in min16float3 cBloom, in min16float3 vAdaptedLum, in min16float fVignetting, in float2 WPos, in float2 baseTC)
{
	min16float fExposure;

#if %_RT_SAMPLE4
	// Legacy exposure mode (clamp is in exposure space)
	// Lower min -> allow darker; lower max -> limit brightening
	const min16float minExp = HDREyeAdaptation.y * 0.7h; // allow darker exposure
	const min16float maxExp = HDREyeAdaptation.z * 0.8h; // cap brightening in dark scenes

	const min16float fSceneKey = 1.03h - 2.0h / (2.0h + log2(vAdaptedLum.x + 1.0));
	fExposure = clamp(fSceneKey / vAdaptedLum.x, minExp, maxExp);
#else
	// Modern exposure (clamp is in EV space)
	// Increase min EV -> limit brightening in dark scenes
	// Increase max EV -> allow darker exposure for bright scenes
	min16float4 eye = min16float4(HDREyeAdaptation);
	eye.x -= 0.1h; // raise min EV (less brightening)
	eye.y += 0.8h; // raise max EV (more darkening)

	fExposure = ComputeExposure(vAdaptedLum.y, eye);
#endif

	// DR tuning: Compress highlights (no exposure bias)
	const min16float kHighlightCompression = 0.23h; // 0..1: stronger highlight roll-off
	min16float3 cColor = fVignetting * fExposure * lerp(cScene, cBloom, saturate(HDRBloomColor));
	// Highlight compression (shoulder): only above ~1.0
	min16float3 highlightExcess = max(cColor - 1.0h, 0.0h);
	min16float3 cHighlight = cColor / (1.0h + highlightExcess * kHighlightCompression);
	min16float3 highlightMask = saturate(cColor - 1.0h);
	cColor = lerp(cColor, cHighlight, highlightMask);

	// HDR color grading
	min16float fLuminance = GetLuminance(cColor);
	cColor = fLuminance + HDRColorBalance.a * ( cColor - fLuminance ); // saturation
	cColor *= HDRColorBalance.rgb; // color balance

	min16float3 cTonemapped = ToneMap_FilmMapping(cColor);
	min16float3 cSRGB = LinearToSRGB(cTonemapped);
	min16float3 cLUT = cSRGB;

#if %_RT_SAMPLE1
	// Apply color-chart (in sRGB/REC.709/REC.2020, because it's a eye-balling mapping between two images viewed in sRGB)
	TexColorChart2D(colorChartTex, linearClampSS, cLUT);
#endif

	// WH[Owlcat/Kazakov]: Moved from PostAA::FinalComposition
	// Apply grain in screen color-space
	// WH[TBa]: implicit truncation of vector type, KCD2-448804
	ApplyFilmGrain(cLUT, cLUT, WPos, baseTC);

	// WH[Owlcat/Kazakov]: Added for photomode. HW_PCF_COMPARE is repurposed
#if %_RT_HW_PCF_COMPARE
	ApplyWhiteBalance(cLUT);
#endif

#if %_RT_SAMPLE0
	// WH[DH]: SDR pipeline has mismatched gamma curve
	min16float3 cHDR = Gamma22ToLinear(cLUT);
	cHDR = Inverse_ToneMap_FilmMapping(cHDR);

	// WH[DH]: Restore original luminance after clipping by Hable tonemapper
	min16float fOriginalLuminance = GetLuminance(cColor);
	cHDR *= lerp(1.0f, max(1.0f, fOriginalLuminance / max(1e-7, GetLuminance(cHDR))), 1.0f - saturate(fOriginalLuminance) * 0.3f);

	// WH[DH]: Match the mid gray value shifted by Hable tonemapper
	cHDR *= MID_GRAY_CORRECTION;

	// WH[DH]: HDR Tonemapping
	cHDR = ToneMap_HDR(Rec709ToRec2020(cHDR), HDRDisplayBrightness, HDRTonemappingContrast, HDRTonemappingLinearStart, HDRTonemappingLinearLength, HDRTonemappingShadow);

	return cHDR;
#else
	return cLUT;
#endif
}

pixout HDRFinalScenePS(vert2frag IN)
{
	float2 ScreenTC = MapViewportToRaster(IN.baseTCScaled.xy);

	min16float  fVignetting = 1;
	min16float3 cBloom = 0;

// WH[MMatous]: Fixed #if by removing '!'
#if %_RT_SAMPLE2 // Vignetting enabled/disabled
	fVignetting = vignettingTex.Sample(linearClampSS, ScreenTC.xy).r;
#endif
#if %_RT_SAMPLE3
	cBloom = bloomTex.Sample(linearClampSS, ScreenTC.xy);
#endif

	// WH[TBa]: implicit truncation of vector type, KCD2-448804
	min16float3 vAdaptedLum = luminanceTex.Load(int3(0, 0, 0)).rgb;
	min16float3 vSample = hdrTex.Load(int3(IN.WPos.xy, 0));

#if %_RT_SAMPLE5
	// WH[DH]: Adjusted sun shafts according to the visual target
	vSample += sunShaftsTex.Sample(linearClampSS, ScreenTC.xy).rgb * SunShafts_SunCol.rgb * 0.16f;
#endif

	// WH[DH]: HDR pipeline
	min16float3 result = HDRComposition(vSample, cBloom, vAdaptedLum, fVignetting, IN.WPos.xy, IN.baseTC.xy);

#if !%_RT_SAMPLE0
#if %_RT_SAMPLE6
	// Apply dithering to remove banding (in non-linear space)
	ApplyRandomDithering(result, IN.WPos.xy);
#endif

	// Software Gamma/Brightness/Contrast (applied on the HDR-to-LDR transition)
	result = saturate(pow(result, HDRUserModification.x) * HDRUserModification.y + HDRUserModification.z);
#endif

	return (pixout)float4(result, 1.0f);
}

pixout HDRFinalSceneDebugPS(vert2frag IN)
{
    min16float3 oSample = 0.0f;

#if %_RT_DEBUG0
	min16float fExposure = 0.00001 * ComputeExposure( luminanceTex.Load(int3(0, 0, 0)).y, min16float4(HDREyeAdaptation) );
	min16float3 vSample = hdrTex.Load(int3(IN.WPos.xy, 0)) * fExposure;
	
	// Apply gamma correction using exact sRGB/REC.709/REC.2020 curve
#if DURANGO
	oSample = LinearToREC709(oSample);
#else
	oSample = LinearToSRGB(oSample);
#endif
	
#elif %_RT_DEBUG1
	min16float3 vSample = hdrTex.Load(int3(IN.WPos.xy, 0));

	if(any(isnan(vSample)) || any(isinf(vSample)))
		oSample = float3(1.0f, 0.0f, 0.0f);
	else if(any(vSample<0.0f))
		oSample = float3(0.0f, 1.0f, 0.0f);
	else 
		oSample = float3(0.5f, 0.5f, 0.5f);
#endif
 
	return (pixout)min16float4(oSample, 1.0f);
}

pixout HDRFinalSceneFixedExposurePS(vert2frag IN)
{
	min16float3 vAdaptedLum = float3(1.0f, 1.0f, 1.0f);
	min16float3 vSample = hdrTex.Load(int3(IN.WPos.xy, 0));
	min16float3 oSample = 0;
	
	{
		// Compute exposure
		const min16float fExposure = 1.0f;
		min16float3 cColor = fExposure * vSample;

#if 0
		// Filmic response curve as proposed by J. Hable
		min16float4 c = min16float4(max(cColor, 0), HDRFilmCurve.w);
		const min16float ShoStren = 0.22 * HDRFilmCurve.x, LinStren = 0.3 * HDRFilmCurve.y, LinAngle = 0.1, ToeStren = 0.2, ToeNum = 0.01 * HDRFilmCurve.z, ToeDenom = 0.3;
		min16float4 compressedCol = ((c * (ShoStren * c + LinAngle*LinStren) + ToeStren*ToeNum) / (c * (ShoStren * c + LinStren) + ToeStren*ToeDenom)) - (ToeNum / ToeDenom);
		oSample = saturate(compressedCol / compressedCol.w);
#endif

		// Apply gamma correction using exact sRGB/REC.709/REC.2020 curve
#if DURANGO
		oSample = LinearToREC709(oSample);
#else
		oSample = LinearToSRGB(oSample);
#endif
	}

	return (pixout)min16float4(oSample, 1.0f);
}

