#include "Common.cfi"
#include "shadelib.cfi"
#include "PostEffectsLib.cfi"
#include "CommonColorTransforms.cfi"

// Shader global descriptions
float Script : STANDARDSGLOBAL
<
  string Script =
           "NoPreview;"
           "LocalConstants;"
           "ShaderDrawType = Custom;"
           "ShaderType = PostProcess;"
>; 

////////////////////////////////////////////////////////////////////////////////////////////////////
/// OcclusionCheckQuad technique ///////////////////////////////////////////////////////////////////

struct vtxOcclCheck
{
  float4 HPosition  : POSITION;
};

float4 OcclCheckParams;

vtxOcclCheck OcclCheckVS(vtxInWPOS IN)
{

  vtxOcclCheck OUT = (vtxOcclCheck)0; 

  float4 vPos = IN.Position;
  vPos.y = 1 -vPos.y;
  OUT.HPosition = float4(vPos.xy*2-1, vPos.z, 1.0);

  return OUT;

}

pixout OcclCheckPS(vtxOcclCheck IN)
{

  pixout OUT = (pixout) 0;
  OUT.Color = float4(1,0,0,1);
  return OUT;

}

technique OcclCheckTechnique
{
  pass p0
  {
    VertexShader = OcclCheckVS();            
    PixelShader = OcclCheckPS();
    CullMode = None;        
  }
}

////////////////////////////////////////////////////////////////////////////////////////////////////
/// For merged edgeAA + SunShafts technique ////////////////////////////////////////////////////////

float4 texToTexParams0;
float4 texToTexParams1;

struct vtxOutAAOpt
{
  float4 HPosition : SV_POSITION;
  float2 baseTC    : TEXCOORD0;
};

vtxOutAAOpt EdgeAAOptVS(uint VertexID : SV_VertexID)
{
  vtxOutAAOpt OUT = (vtxOutAAOpt)0; 
  OUT.HPosition = GetHPos_FromTriVertexID(VertexID);
  float2 baseTC = GetBaseTC_FromTriVertexID(VertexID);
  OUT.baseTC = baseTC;

  return OUT;
}

////////////////////////////////////////////////////////////////////////////////////////////////////
/// SunShafts technique //////////////////////////////////////////////////////////////////////////

/// Constants ////////////////////////////

float4x4 SunShafts_ViewProj;
float4 SunShafts_SunPos;
float4 SunShafts_SunCol;
float4x4 mColorMatrix;
float4 ScratchParams;

cbuffer CBSunShafts : register(b0)
{
	struct
	{
		float4 sunPos;
		float4 params;
	} cbSunShafts;
};

struct vtxOutSunShaftsGen
{
  float4 HPosition  : SV_POSITION; 
  float2 baseTC       : TEXCOORD0;
};


Texture2D<float2> SSHFTM_LDepth    : register(t0);
Texture2D<float4> SSHFTM_Target    : register(t1);
SamplerState  SSHFTM_PCSampler     : register(s0); //point clamp

Texture2D<float4> SSHFTG_Target    : register(t0);
SamplerState  SSHFTG_LCSampler     : register(s0); //linear clamp

/// Samplers ////////////////////////////

vtxOutSunShaftsGen SunShaftsGenVS(uint VertexID : SV_VertexID)
{
  vtxOutSunShaftsGen OUT = (vtxOutSunShaftsGen)0; 
  OUT.HPosition = GetHPos_FromTriVertexID(VertexID);
  OUT.baseTC.xy = GetBaseTC_FromTriVertexID(VertexID);
  return OUT;
}

///////////////// pixel shader //////////////////
pixout SunShaftsMaskGenPS(vtxOutSunShaftsGen IN)
{
    pixout OUT = (pixout) 0;

    // WH[MMatous]: Not using multi-view
    //const uint viewId = 0;
    float2 outRes = CV_ScreenSize.xy;
    float2 inRes;
    SSHFTM_LDepth.GetDimensions(inRes.x, inRes.y);
    float2 scale = outRes / inRes;
    IN.HPosition.xy /= scale;

    min16float sceneDepth = GetLinearDepth(SSHFTM_LDepth, int2(IN.HPosition.xy));
    OUT.Color = min16float4(sceneDepth, sceneDepth, sceneDepth, 1 - sceneDepth.x);
    
    float2 sampleUV = MapViewportToRaster(IN.baseTC.xy);
    // WH[TBa]: implicit truncation of vector type, KCD2-448804
    min16float3 sceneCol = GetTexture2D(SSHFTM_Target, SSHFTM_PCSampler, sampleUV).rgb; // comes straight from hdr scaled target
	
    // cheaper and looks nicer
    // WH[DH]: Keep the output in linear space to safe performance; the ST2084 encoding does not improve the visuals
    OUT.Color.rgb = OUT.Color.rgb * sceneCol;

    return OUT;
}

pixout SunShaftsGenPS(vtxOutSunShaftsGen IN)
{
    pixout OUT;
    OUT.Color = 0.0f;

    float2 sunPosProj = cbSunShafts.sunPos.xy;
    float fSign = cbSunShafts.sunPos.w;

    float2 sunVec = (GetScaledScreenTC(sunPosProj.xy) - IN.baseTC.xy) / CV_HPosScale.xy;
    float fAspectRatio = 1.333 * (CV_ScreenSize.y * CV_HPosScale.x) / (CV_ScreenSize.x * CV_HPosScale.y);

    float sunDist = saturate(fSign) * saturate(1.0f - saturate(length(sunVec * float2(1.0f, fAspectRatio)) * cbSunShafts.params.y));

    // === Hard-coded controls (tweak these) ===
    const float INTENSITY    = 0.6f; // overall strength
    const float LENGTH_SCALE = 1.0f; // 1.0 = vanilla length

    float2 sunDir = (GetScaledScreenTC(sunPosProj.xy) - IN.baseTC.xy) * cbSunShafts.params.x * LENGTH_SCALE * saturate(fSign);

    min16float4 accum = 0; 
    accum += GetTexture2D(SSHFTG_Target, SSHFTG_LCSampler, MapViewportToRaster(IN.baseTC.xy));
    accum += GetTexture2D(SSHFTG_Target, SSHFTG_LCSampler, MapViewportToRaster(IN.baseTC.xy + sunDir.xy * 1.0f)) * (7.0f/8.0f);
    accum += GetTexture2D(SSHFTG_Target, SSHFTG_LCSampler, MapViewportToRaster(IN.baseTC.xy + sunDir.xy * 2.0f)) * (6.0f/8.0f);
    accum += GetTexture2D(SSHFTG_Target, SSHFTG_LCSampler, MapViewportToRaster(IN.baseTC.xy + sunDir.xy * 3.0f)) * (5.0f/8.0f);
    accum += GetTexture2D(SSHFTG_Target, SSHFTG_LCSampler, MapViewportToRaster(IN.baseTC.xy + sunDir.xy * 4.0f)) * (4.0f/8.0f);
    accum += GetTexture2D(SSHFTG_Target, SSHFTG_LCSampler, MapViewportToRaster(IN.baseTC.xy + sunDir.xy * 5.0f)) * (3.0f/8.0f);
    accum += GetTexture2D(SSHFTG_Target, SSHFTG_LCSampler, MapViewportToRaster(IN.baseTC.xy + sunDir.xy * 6.0f)) * (2.0f/8.0f);
    accum += GetTexture2D(SSHFTG_Target, SSHFTG_LCSampler, MapViewportToRaster(IN.baseTC.xy + sunDir.xy * 7.0f)) * (1.0f/8.0f);
    accum /= 4.5f; // original normalization

    OUT.Color.rgb = accum.rgb * sunDist * INTENSITY;
    return OUT;
}


////////////////// technique /////////////////////

technique SunShaftsMaskGen
{
  pass p0
  {
    VertexShader = SunShaftsGenVS() PostSunShaftsVS;
    PixelShader = SunShaftsMaskGenPS() PostSunShaftsPS;  
    CullMode = None;        
  }
}

technique SunShaftsGen
{
  pass p0
  {
    VertexShader = SunShaftsGenVS() PostSunShaftsVS;
    PixelShader = SunShaftsGenPS() PostSunShaftsPS;    
    CullMode = None;        
  }
}
/////////////////////// eof ///
