technique AgcNullExport
{
	pass p0
	{
		VertexShader = AgcQuadVS();
		PixelShader = AgcEmptyPS();
	}
}

technique AgcNullArrayExport
{
	pass p0
	{
		VertexShader = AgcQuadArrayVS();
		PixelShader = AgcEmptyPS();
	}
}

technique AgcZeroExport
{
	pass p0
	{
		VertexShader = AgcQuadVS();
		PixelShader = AgcZeroPS();
	}
}

technique AgcZeroArrayExport
{
	pass p0
	{
		VertexShader = AgcQuadArrayVS();
		PixelShader = AgcZeroPS();
	}
}

technique AgcConstantExport
{
	pass p0
	{
		VertexShader = AgcQuadVS();
		PixelShader = AgcConstantPS();
	}
}

technique AgcConstantArrayExport
{
	pass p0
	{
		VertexShader = AgcQuadArrayVS();
		PixelShader = AgcConstantPS();
	}
}

technique AgcMemSet32
{
	pass p0
	{
		ComputeShader = AgcMemSet32CS();
	}
}

technique AgcMemSet128
{
	pass p0
	{
		ComputeShader = AgcMemSet128CS();
	}
}

technique AgcMemCpy
{
	pass p0
	{
		ComputeShader = AgcMemCpyCS();
	}
}

