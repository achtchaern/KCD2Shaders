//--------------------------------------------------------------------------------------------------  		   
// Common Shadow map functions
//--------------------------------------------------------------------------------------------------

 // WH[TBa]: this should ideally be RT flag, but we are fine with having the value hardcoded, KCD2-117194
#define VOLUMETRIC_CLOUD_SHADOWS_WH 1

// Bit mask for forward shadows. Needs to match up with engine side
#define FORWARD_SHADOWS_CASCADE_0           0x1
#define FORWARD_SHADOWS_CASCADE_1           0x2
#define FORWARD_SHADOWS_CASCADE_2           0x4
#define FORWARD_SHADOWS_CASCADE_3           0x8

#define FORWARD_SHADOWS_CASCADE0_SINGLE_TAP 0x10
#define FORWARD_SHADOWS_CLOUD_SHADOWS       0x20

//--------------------------------------------------------------------------------------------------
//Shadow pass

#define MAX_SHADOW_SAMPLES_NUM 16
#define HALF_MAX_SHADOW_SAMPLES_NUM 8

// forward shadow map sampling parameters.

struct SShadowSamplingParams
{
	float4x4 TexGen0;
	float4x4 TexGen1;
	float4x4 TexGen2;
	float4x4 TexGen3;

	float4 InvShadowMapSize;
	float4 DepthTestBias; // defines how hard depth test is (default is 100 - hard test)
	float4 OneDivFarDist;
	float4 KernelRadius;

	float4 CloudShadowParams;
	float4 CloudShadowAnimParams;

	float4 IrregKernel2D[HALF_MAX_SHADOW_SAMPLES_NUM];

    float4 VolFogShadowRange;
};

cbuffer CBShadowSampling : register(b3)
{
    struct
	{
		float4x4 TexGen0;
		float4x4 TexGen1;
		float4x4 TexGen2;
		float4x4 TexGen3;

		float4 InvShadowMapSize;
		float4 DepthTestBias; // defines how hard depth test is (default is 100 - hard test)
		float4 OneDivFarDist;
		float4 KernelRadius;

		float4 CloudShadowParams;
		float4 CloudShadowAnimParams;

		float4 IrregKernel2D[HALF_MAX_SHADOW_SAMPLES_NUM];

		float4 VolFogShadowRange;
	} cbShadowSamplingParams;
};
//--------------------------------------------------------------------------------------------------

SamplerState SAMPLER_STATE_depthMapSamplerLinear : SS_Shadow0
{
    // sampler state
    Filter = MIN_MAG_LINEAR_MIP_POINT;
    AddressU = Clamp;
    AddressV = Clamp;
};

//single shadow maps
SamplerComparisonState SAMPLER_STATE_depthMapSampler : SS_Shadow2
{
    Filter = COMPARISON_MIN_MAG_LINEAR_MIP_POINT;
    AddressU = Clamp;
    AddressV = Clamp;
};

Texture2D<float4> depthMapSampler0 : TS_Shadow0;
Texture2D<float4> depthMapSampler1 : TS_Shadow2;
Texture2D<float4> depthMapSampler2 : TS_Shadow4;
Texture2D<float4> depthMapSampler3 : TS_Shadow6;

sampler2D sRotSampler = sampler_state
{
  Texture = %ENGINE%/EngineAssets/Textures/rotrandom.dds;
  MinFilter = POINT;
  MagFilter = POINT;
  MipFilter = POINT; 
  AddressU = Wrap;
  AddressV = Wrap;	
};

//--------------------------------------------------------------------------------------------------

void ShadowTexSpace(float4 vPos, float4x4 TexGen, float4x4 InstMatrix, float fInvFarDist, out float4 p)
{

  float4x4 shadowM = mul(TexGen, InstMatrix);
	p = mul(shadowM, vPos);

	//apply linear space for all shadow formats for now
#if !%_RT_POINT_LIGHT 
	p.z = p.z * fInvFarDist;
#endif
}

//version for non-instanced objects
void ShadowTexSpace(float4 vPos, float4x4 shadowM, float fInvFarDist, out float4 p)
{
	p = mul(shadowM, vPos);

	//apply linear space for all shadow formats for now
#if !%_RT_POINT_LIGHT 
	p.z = p.z * fInvFarDist;
#endif
}

//should match to the kernel table
int GetShadowSamplesNum()
{
  int nSamples;
#if !%_RT_QUALITY && !%_RT_QUALITY1
   nSamples = 4;	//low spec
#elif %_RT_QUALITY && !%_RT_QUALITY1
   nSamples = 8;  //med spec
#elif !%_RT_QUALITY && %_RT_QUALITY1
   nSamples = 16;//8;  //high spec
#elif %_RT_QUALITY && %_RT_QUALITY1
   nSamples = 16;//8; //veryhigh 
#else
   // #warning Unknown shader quality mode
   nSamples = 1;
#endif  

  return nSamples;
}

int GetShadowQuality()
{
  int nQuality;
#if !%_RT_QUALITY && !%_RT_QUALITY1
   nQuality = QUALITY_LOW;
#elif %_RT_QUALITY && !%_RT_QUALITY1
   nQuality = QUALITY_MEDIUM;
#elif !%_RT_QUALITY && %_RT_QUALITY1
   nQuality = QUALITY_HIGH;
#elif %_RT_QUALITY && %_RT_QUALITY1
   nQuality = QUALITY_VERYHIGH;
#else
   // #warning Unknown shader quality mode
   nQuality = QUALITY_VERYHIGH;
#endif  
  return nQuality;
}

//should match to the kernel table
float2 GetKernelSize(float2 kernelRadius)
{
  float2 KernelSize;
  if (GetShadowQuality() == QUALITY_LOW)
  {
    KernelSize = float2(1.1f,1.1f);	//low spec
  }
	else
  {
    KernelSize = kernelRadius.xy;
  }

#if %_RT_POINT_LIGHT && !%_RT_SAMPLE4
  if (GetShadowQuality() != QUALITY_VERYHIGH)
  {
    //adjust kernel size based on sm scale
    KernelSize *= float2 (1.0f/3.0f, 1.0f/2.0f);
  }
#endif

  return KernelSize;
}

struct ShadowSamplingContext
{
	SamplerComparisonState comparisonSampler;
	SamplerState           pointSamplerWrap;
	SamplerState           pointSamplerClamp;
	SamplerState           bilinearSamplerWrap;
	
    Texture2D<min16float4> noiseTex;
};

struct IrregularFilterKernel
{
	float4 taps[HALF_MAX_SHADOW_SAMPLES_NUM];
	float2 scale;
	float2 noiseLookupPos;
	float4 adaption;
};

struct ShadowCascades
{
    Texture2D<min16float4> shadowMap0;
	Texture2D<min16float4> shadowMap1;
	Texture2D<min16float4> shadowMap2;
	Texture2D<min16float4> shadowMap3;
	// WH[TBa]: vol clouds use different texture format, KCD2-117194
#if VOLUMETRIC_CLOUD_SHADOWS_WH
	Texture3D<min16float4> cloudShadowTex;
#else
	Texture2D<min16float4> cloudShadowTex;
#endif
};

void shadow_sample(Texture2D<min16float4> depthMap, SamplerComparisonState comparisonSampler, float3 p, out min16float shadow)
{
	shadow = depthMap.SampleCmpLevelZero( comparisonSampler, p.xy, p.z );
}

void SampleRotated(Texture2D<min16float4> depthMap, SamplerComparisonState comparisonSampler, float3 p, min16float4 rotMatr, float2 kernel, out min16float result)
{
	// Rotate tap for this pixel location
    min16float2 rotatedOff;

	rotatedOff.x = dot(rotMatr.xy, kernel);
	rotatedOff.y = dot(rotMatr.zw, kernel);

	float2 fetchPos = p.xy + rotatedOff.xy;

	shadow_sample(depthMap, comparisonSampler, float3(fetchPos.xy, p.z), result);
}

void DoubleSampleRotated(Texture2D<min16float4> depthMap, SamplerComparisonState comparisonSampler, float3 p, min16float4 rotMatr, min16float4 kernel, out min16float2 result)
{
	// Rotate tap for this pixel location
    min16float4 rotatedOff;

	rotatedOff = rotMatr.xyzw * kernel.xxww +
	             rotMatr.zwxy * kernel.yyzz;


	float4 fetchPos = p.xyxy + rotatedOff;

	shadow_sample(depthMap, comparisonSampler, float3(fetchPos.xy,p.z), result.x);
	shadow_sample(depthMap, comparisonSampler, float3(fetchPos.zw,p.z), result.y);
}

void irregular_filter_impl(Texture2D<min16float4> depthMap, ShadowSamplingContext samplingContext, IrregularFilterKernel filterKernel, float4 p, float4 rotMatr, min16float2 kernelRadius, out min16float shadowTest, const bool bContactHardening = false)
{
    min16float kernelOffset = 0;
    min16float kernelSize = GetShadowSamplesNum() / 2;

	const int kernelStepSize = 1;

	/////////////////////////////
	//depth range estimation
	if (bContactHardening)
	{
        min16float accumArea = 0.0f;
		min16float accumCoverage = 0.01f;
		min16float2 kernelScale = kernelRadius * 2.7;

		for(int i=kernelOffset; i<kernelSize; i+=kernelStepSize) // Loop over taps
		{
            min16float4 sampleDepth;
			sampleDepth.x = depthMap.SampleLevel(samplingContext.pointSamplerClamp, p.xy + filterKernel.taps[i+0].xy * kernelScale, 0).r;
			sampleDepth.y = depthMap.SampleLevel(samplingContext.pointSamplerClamp, p.xy + filterKernel.taps[i+0].zw * kernelScale, 0).r;
			sampleDepth.z = depthMap.SampleLevel(samplingContext.pointSamplerClamp, p.xy + filterKernel.taps[i+1].xy * kernelScale, 0).r;
			sampleDepth.w = depthMap.SampleLevel(samplingContext.pointSamplerClamp, p.xy + filterKernel.taps[i+1].zw * kernelScale, 0).r;

            min16float4 localArea = (p.zzzz - sampleDepth);
            min16float4 samplNum = localArea > 0.0f;
			accumCoverage += dot(samplNum, float4(1,1,1,1));

			localArea = min(abs(localArea), filterKernel.adaption.xxxx); 
			accumArea += dot(localArea.xyzw, samplNum.xyzw);
		}

		float kernelAdjScale = 0.0f;

		if (accumCoverage > 0.1f)
		{
			kernelAdjScale = accumArea/accumCoverage;
			kernelAdjScale = kernelAdjScale * filterKernel.adaption.y;
			rotMatr *= max(kernelAdjScale, filterKernel.adaption.z);
		}
		else
		{
			rotMatr *= filterKernel.adaption.z;
		}
	}
	/////////////////////////////
	
	shadowTest = 0;
		
    [unroll]
	for(int i=kernelOffset; i<kernelSize; i+=kernelStepSize) // Loop over taps
	{
        min16float4 inShadow;
		DoubleSampleRotated(depthMap, samplingContext.comparisonSampler, p.xyz, rotMatr, filterKernel.taps[i+0], inShadow.xy);
		DoubleSampleRotated(depthMap, samplingContext.comparisonSampler, p.xyz, rotMatr, filterKernel.taps[i+1], inShadow.zw);

        min16float fInvSamplNum = (1.0 / GetShadowSamplesNum());
		shadowTest += dot(inShadow,fInvSamplNum.xxxx);
	}
}

// Bring parameters into tex space first and then call irregular_filter_impl 
void irregular_filter(Texture2D<min16float4> depthMap, float2 invShadowMapSize, ShadowSamplingContext samplingContext, IrregularFilterKernel filterKernel, float4 p, out min16float shadowTest, const bool bContactHardening = false)
{
	float2 randDirTC = filterKernel.noiseLookupPos.xy;
	float2 kernelRadius = filterKernel.scale * invShadowMapSize;

    min16float2 rotSample = GetTexture2D(samplingContext.noiseTex, samplingContext.pointSamplerWrap, randDirTC.xy).xy * kernelRadius.xy;
    min16float4 rotMatr = float4(rotSample.x, -rotSample.y, rotSample.y, rotSample.x);
	
	irregular_filter_impl(depthMap, samplingContext, filterKernel, p, rotMatr, kernelRadius, shadowTest, bContactHardening);
}

min16float GetVolumetricCloudShadow(Texture3D<min16float4> volCloudShadowTex, SamplerState volCloudSState, float3 worldPos, min16float3 sunDir, min16float4 params, min16float4 animParams, float shadowStrength)
{
    const min16float cloudBottomAltitude = params.x;
	const min16float cloudTopAltitude = params.y;
	const min16float invCloudShadowRamp = params.z;
	const min16float invCloudThickness = params.w;
	const min16float2 worldAlignmentOffset = animParams.xy;
	const min16float2 invTilingSize = animParams.zw;
	const min16float2 textureCenterOffset = float2(0.5f, 0.5f);

    const min16float d = (abs(sunDir.z) < 0.0000001f) ? sign(sunDir.z) * 0.0000001f : sunDir.z;
    const min16float t = (worldPos.z > cloudBottomAltitude) ? 0.0f : (cloudBottomAltitude - worldPos.z) / d;
    const min16float decayAboveCloud = 1.0f - saturate((cloudTopAltitude - worldPos.z) * invCloudShadowRamp);

    min16float3 uvw;
	uvw.xy = (t * sunDir.xy + (worldPos.xy - worldAlignmentOffset.xy)) * invTilingSize.xy + textureCenterOffset.xy;
	uvw.z = saturate((worldPos.z - cloudBottomAltitude) * invCloudThickness);

	float opticalThickness = volCloudShadowTex.SampleLevel(volCloudSState, uvw.xyz, 0.0f).x;
	return max(decayAboveCloud, exp(-opticalThickness * shadowStrength));
}

min16float GetCloudShadowCommon(float3 worldPos, Texture2D<min16float4> cloudShadowTex, SamplerState bilinearSamplerWrap, min16float4 vAnimParams, min16float4 vParams)
{
    min16float2 uv = ComputeCloudShadowMapUV(worldPos);
    min16float fCloudsShadow = saturate(GetTexture2DLod(cloudShadowTex, bilinearSamplerWrap, min16float4((uv * vAnimParams.xy - vAnimParams.zw), 0, 0)).r * vParams.w);
	return vParams.z>0 ? 1 - fCloudsShadow : fCloudsShadow;
}

min16float GetCloudShadowCommon(float3 worldPos, Texture2D<min16float4> cloudShadowTex, SamplerState bilinearSamplerWrap, min16float4 vAnimParams, min16float4 vParams, min16float3 sunDirNormalized)
{
    min16float2 uv = ComputeCloudShadowMapUV(worldPos, sunDirNormalized);
    min16float fCloudsShadow = saturate(GetTexture2DLod(cloudShadowTex, bilinearSamplerWrap, min16float4((uv * vAnimParams.xy - vAnimParams.zw), 0, 0)).r * vParams.w);
	return vParams.z>0 ? 1 - fCloudsShadow : fCloudsShadow;
}

min16float GetCloudShadow(min16float3 worldPos, SShadowSamplingParams params, ShadowCascades shadowCascades, ShadowSamplingContext samplingContext)
{
	return GetCloudShadowCommon(worldPos, shadowCascades.cloudShadowTex, samplingContext.bilinearSamplerWrap, params.CloudShadowAnimParams, params.CloudShadowParams);
}

uint GetForwardShadowsCascadeMask(SShadowSamplingParams params)
{
	return asuint(params.KernelRadius.z);
}

bool ShadowCascadeSample(Texture2D<min16float4> depthMap, ShadowSamplingContext samplingContext, SShadowSamplingParams params, float4 p, min16float2 randDirTC, min16float depthTestBias, out min16float fShadow, bool bSingleTap = false)
{	
	fShadow = 1;
	
	p.xy /= p.w;
	p.z -= depthTestBias;
		
	if(p.x >= 0 && p.x <= 1 && p.y >= 0 && p.y <= 1 && p.z <= 1)
	{
		if(bSingleTap)
		{
			shadow_sample(depthMap, samplingContext.comparisonSampler, p.xyz, fShadow);
		}
		else
		{
			IrregularFilterKernel filterKernel;
			filterKernel.taps = params.IrregKernel2D;
			filterKernel.scale = GetKernelSize(params.KernelRadius.xy);
			filterKernel.noiseLookupPos = randDirTC * (filterKernel.scale.y * 15.h);

			irregular_filter(depthMap, params.InvShadowMapSize.xx, samplingContext, filterKernel, p, fShadow);
			
			fShadow = pow(fShadow,2);
		}
		return true;
	}
	
	return false;
}

min16float ShadowDepthTest(
	SShadowSamplingParams params,
	ShadowCascades shadowCascades,
	ShadowSamplingContext samplingContext,
	float3 worldPos,
	bool bSampleCloudShadows = true,
	bool bForceSingleTap = false)
{
	const uint nCascadeMask = GetForwardShadowsCascadeMask(params);
	const bool bSingleTapFirstCascade = bForceSingleTap || (nCascadeMask & FORWARD_SHADOWS_CASCADE0_SINGLE_TAP);
	
    min16float fShadow = 1;
	
	if(nCascadeMask != 0) 
	{
		float4 p;
		ShadowTexSpace(float4(worldPos, 1), params.TexGen0, params.OneDivFarDist.x, p);
        const min16float2 randDirTC = p.xy / p.w * 1000.0;
		
		bool bDone = ShadowCascadeSample(shadowCascades.shadowMap0, samplingContext, params, p, randDirTC, params.DepthTestBias.x, fShadow, bSingleTapFirstCascade);

		[branch]
		if(!bDone && (nCascadeMask & FORWARD_SHADOWS_CASCADE_1))
		{
			ShadowTexSpace(float4(worldPos, 1), params.TexGen1, params.OneDivFarDist.y, p);
			bDone = ShadowCascadeSample(shadowCascades.shadowMap1, samplingContext, params, p, randDirTC, params.DepthTestBias.y, fShadow, true);
		
			[branch]
			if(!bDone && (nCascadeMask & FORWARD_SHADOWS_CASCADE_2))
			{
				ShadowTexSpace(float4(worldPos, 1), params.TexGen2, params.OneDivFarDist.z, p);
				bDone = ShadowCascadeSample(shadowCascades.shadowMap2, samplingContext, params, p, randDirTC, params.DepthTestBias.z, fShadow, true);
				
				[branch]
				if(!bDone && (nCascadeMask & FORWARD_SHADOWS_CASCADE_3))
				{
					ShadowTexSpace(float4(worldPos, 1), params.TexGen3, params.OneDivFarDist.w, p);
					ShadowCascadeSample(shadowCascades.shadowMap3, samplingContext, params, p, randDirTC, params.DepthTestBias.w, fShadow, true);
				}
			}
		}
	}

	if(bSampleCloudShadows && (nCascadeMask & FORWARD_SHADOWS_CLOUD_SHADOWS))
	{
		// WH[TBa]: vol clouds use different function, KCD2-117194
#if VOLUMETRIC_CLOUD_SHADOWS_WH
		min16float fCloudShadow = GetVolumetricCloudShadow(
			shadowCascades.cloudShadowTex, ssMaterialTrilinearBorder,
			worldPos, CV_SunLightDir.xyz, params.CloudShadowParams, params.CloudShadowAnimParams, CV_HDRMultiplier_CloudShadow_CLSDebugWH.y);
#else
		min16float fCloudShadow = GetCloudShadow(worldPos, params, shadowCascades, samplingContext);
#endif
		fShadow *= fCloudShadow;
	}

	return fShadow;
}

void CalculateDetailSSShadow(
#if %_RT_SAMPLE5 // use transmittance if sun shadows
	Texture2D sceneGBufferA,
#endif
	Texture2D<min16float4> sceneDepthTex,
	const float fDepth0,
	const float3 vPosWS,
	const float3 vPosLight,
	const float4x4 matComosite,
	inout float fInShadow,
	const float4 shadowsParams = float4(0.03f, 1.f, 1000.f, 2000.f), // WH[TBa]: add shadow strength and fadeout range
	const float shadowBias = 0.002) // WH[TomK]: Add ssBias as argument, KCD2-555286
{
	float4 vTC0 = mul(matComosite, float4(vPosWS, 1));

	float maxShadowLength = fDepth0 * CV_NearFarClipDist.y * shadowsParams.x;

	float fadeout = 1.f - smoothstep(shadowsParams.z, shadowsParams.w, fDepth0 * CV_NearFarClipDist.y);

	float4 vTC1 = mul(matComosite, float4(vPosWS + normalize(vPosLight - vPosWS) * maxShadowLength, 1));

	// WH[TBa]: increased number of samples, KCD2-151631
	// WH[TBa]: distinguish LOW, MEDIUM+HIGH and VERYHIGH, KCD2-444074
	const int maxSteps
		= GetShaderQuality() >= QUALITY_VERYHIGH ? 24
		: (GetShaderQuality() >= QUALITY_MEDIUM ? 12 : 6);

	float4 vTCStep = (vTC1 - vTC0) / maxSteps;

	vTC0 += vTCStep;

	float lightAmountMax = 0;

	for (int s = 0; s < maxSteps; s++)
	{
		float4 vTC = vTC0 / vTC0.w;
		vTC.y = -vTC.y;
		vTC.xy = vTC.xy * 0.5f + 0.5f;

		int3 tcInt = int3(vTC.xy * CV_ScreenSize.xy + 0.5f, 0); // WH[TomK]: Rounding error causing artefacts and flickering, KCD2-414633

		float sceneDepth = sceneDepthTex.Load(tcInt).x * CV_NearFarClipDist.y;
		float rayDepth = GetLinearDepth(CV_ProjRatio.y / (vTC.z - CV_ProjRatio.x)) * CV_NearFarClipDist.y;
		rayDepth -= rayDepth * shadowBias; // bias, WH[TomK]: KCD2-555286 - make function argument

#if %_RT_SAMPLE5 // take into account transmittance near the camera, TODO: support transmittance also for local lights
		const float sceneTransmittance = DecodeGBufferTransmittanceLum(sceneGBufferA.Load(tcInt)) * saturate(1.25f - rayDepth * .01f);
#else
		const float sceneTransmittance = 0;
#endif

		float surfaceOpacity = 1.f - sceneTransmittance * .9f;  // transparent shadows from grass & leaves
		float surfaceThickness = 0.025f + rayDepth * shadowsParams.x * 0.1f; // WH[TBa]: slower increase of surface thickness, KCD2-307472, KCD2-106114
		float depthTestHardness = 0.005f;                       // helps with z - fighting on the slopes

		// shadowAmount -> higher means more shadow
		float lightAmount = saturate((rayDepth - sceneDepth) / depthTestHardness) * saturate((sceneDepth + surfaceThickness - rayDepth) / depthTestHardness) * surfaceOpacity;

		lightAmountMax = max(lightAmountMax, lightAmount);

		vTC0 += vTCStep;
	}

	fInShadow *= saturate(1.f - lightAmountMax * shadowsParams.y * fadeout); // WH[TBa]: add shadow strength
}
