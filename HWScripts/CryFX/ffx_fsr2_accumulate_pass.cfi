FfxFloat32 GetNormalizedRemainingLockLifetime(FfxFloat32x3 fLockStatus)
{
    const FfxFloat32 fTrust = fLockStatus[2];
    
    return ffxSaturate(fLockStatus[0] - LockInitialLifetime()) / LockInitialLifetime() * fTrust;
}

void InitializeNewLockSample(out FfxFloat32x3 fLockStatus)
{
    fLockStatus = FfxFloat32x3(0, 0, 1);
